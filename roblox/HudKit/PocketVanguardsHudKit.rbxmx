<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX1"><Properties><string name="Name">PVHudKit</string></Properties><Item class="Script" referent="RBX2"><Properties><string name="Name">PVHudBoot</string><token name="RunContext">2</token><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- PVHudBoot: inicia a HUD (celular na borda esquerda + telas). Script com RunContext = Client dentro da
-- pasta ReplicatedStorage.PVHudKit — roda sozinho para cada jogador. Se preferir, apague este script e chame
-- require(ReplicatedStorage.PVHudKit.PVHud).start() no seu próprio LocalScript.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Hud = require(script.Parent:WaitForChild("PVHud"))

-- se a intro do Pocket Vanguards estiver no jogo, a HUD só aparece quando ela terminar
if ReplicatedStorage:FindFirstChild("PocketVanguardsIntro") then
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local introGui = pg:WaitForChild("PocketVanguardsIntro", 8)
	while introGui and introGui.Parent do
		introGui.AncestryChanged:Wait()
	end
end
Hud.start()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">PVHudConfig</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PVHudConfig: asset IDs and options for the HUD kit.
-- Importe as imagens da pasta images/ (Asset Manager > Bulk Import) e cole os IDs abaixo.
local Config = {}

Config.Images = {
	tris = "rbxassetid://0", -- tris.png (triângulos que formam os cantos inclinados)
	icons = "rbxassetid://0", -- icons.png (todos os ícones)
	tex_rain = "rbxassetid://0", -- tex_rain.png
	tex_halftone = "rbxassetid://0", -- tex_halftone.png
	brush_swipe = "rbxassetid://0", -- brush_swipe.png
	brush_streak = "rbxassetid://0", -- brush_streak.png
	brush_splash = "rbxassetid://0", -- brush_splash.png
	brush_slab = "rbxassetid://0", -- brush_slab.png
	brush_under = "rbxassetid://0", -- brush_under.png
	wallpaper = "rbxassetid://0", -- papel de parede do celular (a imagem do treinador, rival e doutor)
}

Config.Sounds = {
	ui = "rbxassetid://0", -- pv_ui.wav (o mesmo arquivo de sons de menu da intro)
}
-- trechos do pv_ui.wav (segundos)
Config.UiSprite = { tick = { 0, 0.35 }, select = { 2, 3.8 }, save = { 4, 5.8 }, deny = { 6, 7.8 }, open = { 8, 9.8 }, close = { 10, 11.8 }, toggle = { 12, 12.35 }, delete = { 14, 15.8 } }
Config.UiVolume = 1.6

-- fonte dos títulos (troque pela fonte do seu jogo se quiser)
Config.DisplayFont = Font.new("rbxasset://fonts/families/RobotoCondensed.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)

Config.ReducedMotion = false -- true desliga as animações
Config.PhoneKey = Enum.KeyCode.M -- abre o celular
Config.PhoneGamepadKey = Enum.KeyCode.ButtonSelect
Config.DisplayOrder = 20

-- apps do celular: id da tela, nome, ícone. Telas que você já tem: coloque screen = nil e use HudApi.AppOpened
Config.PhoneApps = {
	{ id = "ficha", name = "Fighters", icon = "i_fighters" },
	{ id = "ecodex", name = "Ecodex", icon = "i_ecodex", badge = true },
	{ id = "bag", name = "Mochila", icon = "i_bag" },
	{ id = "perfil", name = "Perfil", icon = "i_profile" },
	{ id = "settings", name = "Config.", icon = "i_settings" },
	{ id = "map", name = "Mapa", icon = "i_map" },
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">PVData</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PVData: the ONLY file you connect to your game. Every screen reads from these functions and calls the
-- setters when the player changes something. The versions below hold demo data in memory; replace
-- each function body with reads/writes to your own systems (profile, party, inventory, dex...).
-- After your data changes from outside the HUD, call PVData.Changed:Fire("moves" | "fighter" | "dex" | "profile").
local Players = game:GetService("Players")

local D = {}
D.Changed = Instance.new("BindableEvent")

-- ------------------------------------------------------------------ fighter currently opened in the sheet
local fighter = {
	name = "Nome do lutador",
	level = 12,
	typeKey = "martial", -- martial, sombra, fogo, raio, agua, vento, terra, onirico, normal
	species = "Espécie",
	hp = { 72, 104 }, en = { 100, 100 }, xp = { 40, 315 },
	portrait = nil, -- "rbxassetid://..." image, or leave nil and set portraitModel
	portraitModel = nil, -- a Model to show in a ViewportFrame (e.g. the fighter's rig)
	favorite = false,
	stats = { { "HP", 62, 8 }, { "Poder", 48, 0 }, { "Defesa", 35, 4 }, { "Velocidade", 71, 0 }, { "Foco", 40, 6 } }, -- {name, base (0-100), bonus}
	freePoints = 0,
	talent = { name = "Nome do talento", desc = "Descrição do talento em uma ou duas linhas, dizendo quando ativa.", rank = 2, maxRank = 5, effects = { "Efeito principal", "Efeito secundário" }, nextUnlock = "2º talento · Desbloqueia no nível 30" },
	passives = { { name = "Nome da passiva", desc = "O que ela faz, em uma linha.", unlocked = true }, { name = "Nome da passiva", desc = "Desbloqueia no nível 20.", unlocked = false } },
	item = nil, -- id of the held item
	ultimate = { name = "Nome da ultimate", note = "1× por batalha · 100 EN" }, -- nil for fighters without one
}
function D.getFighter()
	return fighter
end
function D.setFavorite(on)
	fighter.favorite = on
end
function D.setNickname()
	-- open your own text box here
end

-- ------------------------------------------------------------------ moves
local moves = {
	{ id = "rap", name = "Golpe Rápido", type = "normal", cat = "fisico", lv = 1, power = 40, acc = 100, pp = 30, effect = "Sempre ataca primeiro no turno." },
	{ id = "pun", name = "Punho Sombrio", type = "sombra", cat = "fisico", lv = 1, power = 55, acc = 95, pp = 20, effect = "20% de chance de reduzir a defesa do alvo." },
	{ id = "pas", name = "Passo Fantasma", type = "martial", cat = "status", lv = 4, pp = 15, effect = "Aumenta a esquiva por 3 turnos." },
	{ id = "dup", name = "Corte Duplo", type = "martial", cat = "fisico", lv = 7, power = 30, acc = 90, pp = 15, effect = "Acerta duas vezes seguidas.", hits = 2 },
	{ id = "cha", name = "Chama Negra", type = "fogo", cat = "especial", lv = 9, power = 70, acc = 90, pp = 10, effect = "10% de chance de queimar." },
	{ id = "rug", name = "Rugido da Arena", type = "martial", cat = "status", lv = 11, acc = 100, pp = 20, effect = "Reduz o ataque de todos os inimigos." },
	{ id = "ond", name = "Onda Sombria", type = "sombra", cat = "especial", lv = 12, power = 75, acc = 100, pp = 10, effect = "Atinge todos os inimigos ao mesmo tempo.", isNew = true },
	{ id = "oni", name = "Lâmina Onírica", type = "onirico", cat = "especial", lv = 15, power = 85, acc = 95, pp = 8, effect = "20% de chance de adormecer o alvo." },
	{ id = "ral", name = "Relâmpago Marcial", type = "raio", cat = "fisico", lv = 19, power = 90, acc = 85, pp = 8, effect = "Pode paralisar (15%)." },
	{ id = "mil", name = "Mil Cortes", type = "martial", cat = "fisico", lv = 30, power = 120, acc = 75, pp = 5, effect = "Acerta de 2 a 5 vezes." },
}
local equipped = { "pun", "dup", "cha", "pas" }
-- list = every move of the fighter (learned + future), equipped = 4 ids, level = current level
function D.getMoves()
	return { list = moves, equipped = equipped, level = fighter.level }
end
-- put moveId in slot (1-4). If it was already in another slot the two swap. Return true if saved.
function D.equipMove(slot, moveId)
	local other = table.find(equipped, moveId)
	if other then
		equipped[other] = equipped[slot]
	end
	equipped[slot] = moveId
	for _, m in ipairs(moves) do
		if m.id == moveId then
			m.isNew = nil
		end
	end
	return true
end
function D.swapSlots(a, b)
	equipped[a], equipped[b] = equipped[b], equipped[a]
	return true
end

-- ------------------------------------------------------------------ held items (from the bag)
local items = {
	{ id = "faixa", name = "Faixa Rubra", desc = "+10% de Poder.", count = 3, color = Color3.fromRGB(227, 24, 47) },
	{ id = "amuleto", name = "Amuleto Sereno", desc = "Recupera 5% de HP por turno.", count = 1, color = Color3.fromRGB(63, 207, 154) },
	{ id = "lente", name = "Lente Focal", desc = "+15 de Foco.", count = 2, color = Color3.fromRGB(45, 155, 240) },
	{ id = "pena", name = "Pena Veloz", desc = "Age primeiro no 1º turno.", count = 1, color = Color3.fromRGB(245, 197, 66) },
	{ id = "selo", name = "Selo Sombrio", desc = "Golpes Sombra +10%.", count = 1, color = Color3.fromRGB(122, 134, 201) },
	{ id = "pedra", name = "Pedra Onírica", desc = "Chance de sono +10%.", count = 0, color = Color3.fromRGB(255, 122, 217) },
}
function D.getHeldItems()
	return items
end
function D.equipItem(id)
	for _, it in ipairs(items) do
		if it.id == fighter.item then
			it.count += 1
		end
		if it.id == id then
			it.count -= 1
		end
	end
	fighter.item = id
	return true
end
function D.removeItem()
	for _, it in ipairs(items) do
		if it.id == fighter.item then
			it.count += 1
		end
	end
	fighter.item = nil
	return true
end

-- ------------------------------------------------------------------ Ecodex
local dex = {
	{ no = "001", name = "Brasalume", types = { "fogo" }, status = "caught", kind = "Eco Brasa", height = 0.6, weight = 8.5, habitat = "Vulcão Adormecido", desc = "Guarda uma brasa na cauda que nunca apaga.", stats = { 45, 60, 40, 65, 55 }, image = nil },
	{ no = "002", name = "Brasardente", types = { "fogo", "martial" }, status = "seen", kind = "Eco Brasa", habitat = "Vulcão Adormecido" },
	{ no = "003", name = "Gotaluz", types = { "agua" }, status = "caught", kind = "Eco Orvalho", height = 0.4, weight = 3.2, habitat = "Lago Espelhado", desc = "Nasce do orvalho da primeira manhã do ano.", stats = { 50, 40, 55, 65, 50 } },
	{ no = "004", name = "Voltisco", types = { "raio" }, status = "caught", kind = "Eco Faísca", height = 0.5, weight = 6.1, habitat = "Mato Alto", desc = "Esconde-se no mato alto e salta quando alguém passa.", stats = { 40, 55, 35, 60, 90 } },
	{ no = "005", name = "Sombrelo", types = { "sombra" }, status = "seen", kind = "Eco Penumbra", habitat = "Floresta das Lanternas" },
	{ no = "006", name = "???", types = { "normal" }, status = "unknown" },
}
function D.getDex()
	return { seen = 5, caught = 3, total = 120, entries = dex }
end

-- ------------------------------------------------------------------ trainer profile
function D.getProfile()
	local p = Players.LocalPlayer
	return {
		name = p and p.DisplayName or "Treinador",
		userId = p and p.UserId or 0,
		title = "Caçador de Ecos",
		money = 12450,
		id = "#" .. string.format("%05d", (p and p.UserId or 0) % 100000),
		playtime = "12h 40min", wins = 58, caught = "21 / 120", seen = 34, since = "24/09/2026",
		badges = {
			{ name = "Brasa", color = Color3.fromRGB(255, 106, 43), earned = true }, { name = "Maré", color = Color3.fromRGB(45, 155, 240), earned = true },
			{ name = "Trovão", color = Color3.fromRGB(242, 194, 48), earned = true }, { name = "Penumbra", color = Color3.fromRGB(122, 134, 201), earned = false },
			{ name = "Rocha", color = Color3.fromRGB(192, 138, 74), earned = false }, { name = "Brisa", color = Color3.fromRGB(63, 207, 154), earned = false },
			{ name = "Arena", color = Color3.fromRGB(160, 102, 255), earned = false }, { name = "Sonho", color = Color3.fromRGB(255, 122, 217), earned = false },
		},
		team = { { name = "Brasardente", level = 15, typeKey = "fogo" }, { name = "Voltisco", level = 11, typeKey = "raio" }, false, false, false, false },
	}
end
-- options on the profile screen: "title", "avatar", "settings", "account"
function D.profileOption(name)
	print("[PVHud] opção do perfil:", name)
end

return D
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">PVStyle</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PVStyle: the Carmesim look built from GuiObjects (Roblox has no clip-path, so slanted shapes are a
-- centre rectangle + triangle sprites). Every screen of the HUD kit is made only from these pieces.
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Config = require(script.Parent:WaitForChild("PVHudConfig"))

local S = {}
S.Config = Config
local A = Config.Images

S.C = {
	red = Color3.fromRGB(227, 24, 47), red2 = Color3.fromRGB(255, 48, 72), deep = Color3.fromRGB(122, 9, 23),
	gold = Color3.fromRGB(226, 207, 142), gold2 = Color3.fromRGB(245, 197, 66),
	ink = Color3.fromRGB(12, 10, 11), ink2 = Color3.fromRGB(26, 19, 22), ink3 = Color3.fromRGB(36, 27, 31), line = Color3.fromRGB(58, 47, 51),
	bone = Color3.fromRGB(246, 241, 234), dim = Color3.fromRGB(165, 156, 148), mute = Color3.fromRGB(111, 103, 96), ok = Color3.fromRGB(69, 212, 131),
}
S.TYPES = {
	martial = { "Martial", Color3.fromRGB(160, 102, 255) }, sombra = { "Sombra", Color3.fromRGB(122, 134, 201) }, fogo = { "Fogo", Color3.fromRGB(255, 106, 43) },
	raio = { "Raio", Color3.fromRGB(242, 194, 48) }, agua = { "Água", Color3.fromRGB(45, 155, 240) }, vento = { "Vento", Color3.fromRGB(63, 207, 154) },
	terra = { "Terra", Color3.fromRGB(192, 138, 74) }, onirico = { "Onírico", Color3.fromRGB(255, 122, 217) }, normal = { "Normal", Color3.fromRGB(179, 172, 164) },
}
S.DISPLAY = Config.DisplayFont
S.BODY = Font.new("rbxasset://fonts/families/RobotoCondensed.json", Enum.FontWeight.Medium)
S.BODYB = Font.new("rbxasset://fonts/families/RobotoCondensed.json", Enum.FontWeight.Bold)

S.EASE_OUT = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
S.SNAP = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
S.POP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
S.SLOW = TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
S.FOCUS = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local ICONS = {
	i_fighters = { 8, 8 },
	i_ecodex = { 104, 8 },
	i_bag = { 200, 8 },
	i_profile = { 296, 8 },
	i_settings = { 392, 8 },
	i_quest = { 488, 8 },
	i_map = { 584, 8 },
	i_capture = { 680, 8 },
	i_phone = { 8, 104 },
	i_fight = { 104, 104 },
	i_run = { 200, 104 },
	i_audio = { 296, 104 },
	i_video = { 392, 104 },
	i_controls = { 488, 104 },
	i_access = { 584, 104 },
	i_lang = { 680, 104 },
	i_account = { 8, 200 },
	t_martial = { 104, 200 },
	t_sombra = { 200, 200 },
	t_fogo = { 296, 200 },
	t_raio = { 392, 200 },
	t_agua = { 488, 200 },
	t_vento = { 584, 200 },
	t_terra = { 680, 200 },
	t_onirico = { 8, 296 },
	t_normal = { 104, 296 },
	c_fisico = { 200, 296 },
	c_especial = { 296, 296 },
	c_status = { 392, 296 },
	lock = { 488, 296 },
	check = { 584, 296 },
	arrow = { 680, 296 },
	play = { 8, 392 },
	star = { 104, 392 },
	x = { 200, 392 },
	search = { 296, 392 },
	eye = { 392, 392 },
	talent = { 488, 392 },
	item = { 584, 392 },
	statusic = { 680, 392 },
	passive = { 8, 488 }
}
S.ICONS = ICONS

-- string.upper only knows ASCII; this also uppercases the Portuguese accents (á -> Á, ç -> Ç...)
local ACCENTS = { ["á"] = "Á", ["à"] = "À", ["â"] = "Â", ["ã"] = "Ã", ["é"] = "É", ["ê"] = "Ê", ["í"] = "Í", ["ó"] = "Ó", ["ô"] = "Ô", ["õ"] = "Õ", ["ú"] = "Ú", ["ü"] = "Ü", ["ç"] = "Ç", ["ñ"] = "Ñ" }
function S.upper(str)
	return (string.gsub(string.upper(str), "[\xC3][\x80-\xBF]", ACCENTS))
end

-- ------------------------------------------------------------------ basics
function S.new(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = o
	end
	if props.Parent then
		o.Parent = props.Parent
	end
	return o
end
local new = S.new

function S.tween(o, info, goal)
	if Config.ReducedMotion then
		for k, v in pairs(goal) do
			o[k] = v
		end
		return nil
	end
	local t = TweenService:Create(o, info, goal)
	t:Play()
	return t
end

function S.box(parent, x, y, w, h, z, name)
	return new("Frame", { Name = name or "Box", Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, ZIndex = z or 1, Parent = parent })
end

function S.rect(parent, x, y, w, h, color, z, tr)
	return new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = color, BackgroundTransparency = tr or 0, BorderSizePixel = 0, ZIndex = z or 1, Parent = parent })
end

-- triangle sprite, named by the filled corner: LL lower-left, LR lower-right, UL upper-left, UR upper-right
local TRI = { LL = Vector2.new(0, 0), LR = Vector2.new(256, 0), UL = Vector2.new(0, 256), UR = Vector2.new(256, 256) }
function S.tri(parent, kind, x, y, w, h, color, z, tr)
	return new("ImageLabel", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Image = A.tris,
		ImageRectOffset = TRI[kind], ImageRectSize = Vector2.new(256, 256), ImageColor3 = color, ImageTransparency = tr or 0, ZIndex = z or 1, Parent = parent,
	})
end

function S.text(parent, x, y, w, h, str, font, size, color, props)
	local p = {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Text = str, FontFace = font, TextSize = size,
		TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 3, Parent = parent,
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return new("TextLabel", p)
end

-- big italic title with the hard black offset shadow the game uses
function S.title(parent, x, y, w, h, str, size, props)
	local p = props or {}
	local z = p.ZIndex or 4
	local sh = S.text(parent, x + 2, y + 3, w, h, str, S.DISPLAY, size, Color3.new(0, 0, 0), { ZIndex = z, TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left, TextWrapped = p.TextWrapped or false })
	local t = S.text(parent, x, y, w, h, str, S.DISPLAY, size, p.TextColor3 or S.C.bone, { ZIndex = z + 1, TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left, TextWrapped = p.TextWrapped or false })
	t:GetPropertyChangedSignal("Text"):Connect(function()
		sh.Text = t.Text
	end)
	t:GetPropertyChangedSignal("Rotation"):Connect(function()
		sh.Rotation = t.Rotation
	end)
	return t, sh
end

function S.icon(parent, key, x, y, size, color, z)
	local r = ICONS[key] or ICONS.i_settings
	return new("ImageLabel", {
		Name = key, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Image = A.icons,
		ImageRectOffset = Vector2.new(r[1], r[2]), ImageRectSize = Vector2.new(80, 80), ImageColor3 = color or Color3.new(1, 1, 1), ZIndex = z or 3, Parent = parent,
	})
end

function S.brush(parent, kind, x, y, w, h, rot, z, tr)
	return new("ImageLabel", {
		Name = "Brush", Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Image = A["brush_" .. kind],
		Rotation = rot or 0, ImageTransparency = tr or 0, ZIndex = z or 1, Parent = parent,
	})
end

function S.tile(parent, key, x, y, w, h, z, tr, tile)
	return new("ImageLabel", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Image = A[key], ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(tile or 300, tile or 300), ImageTransparency = tr or 0, ZIndex = z or 1, Parent = parent,
	})
end

local function fade(o, rot, from, to)
	new("UIGradient", { Rotation = rot, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, from), NumberSequenceKeypoint.new(0.65, to), NumberSequenceKeypoint.new(1, to) }), Parent = o })
end

-- ------------------------------------------------------------------ slanted shapes
-- "para": parallelogram (top edge shifted right); "right": straight left edge, slanted right edge;
-- "left": slanted left edge, straight right edge; anything else: rectangle
function S.shape(parent, kind, x, y, w, h, s, color, z, tr)
	local g = S.box(parent, x, y, w, h, z, "Shape")
	if kind == "para" then
		S.tri(g, "LR", 0, 0, s + 1, h, color, z, tr)
		S.rect(g, s, 0, w - 2 * s, h, color, z, tr)
		S.tri(g, "UL", w - s - 1, 0, s + 1, h, color, z, tr)
	elseif kind == "right" then
		S.rect(g, 0, 0, w - s, h, color, z, tr)
		S.tri(g, "UL", w - s - 1, 0, s + 1, h, color, z, tr)
	elseif kind == "left" then
		S.tri(g, "LR", 0, 0, s + 1, h, color, z, tr)
		S.rect(g, s, 0, w - s, h, color, z, tr)
	else
		S.rect(g, 0, 0, w, h, color, z, tr)
	end
	return g
end

function S.recolor(shape, color)
	for _, p in ipairs(shape:GetChildren()) do
		if p:IsA("ImageLabel") then
			p.ImageColor3 = color
		elseif p:IsA("Frame") then
			p.BackgroundColor3 = color
		end
	end
end

-- gold-outlined dark panel with rain texture and halftone. returns the panel group and a content frame
function S.panel(parent, x, y, w, h, opts)
	opts = opts or {}
	local kind, s, z = opts.kind or "right", opts.slant or 18, opts.z or 2
	local g = S.box(parent, x, y, w, h, z, opts.name or "Panel")
	S.shape(g, kind, 0, 0, w, h, s, opts.outline or S.C.gold, z)
	S.shape(g, kind, 2, 2, w - 4, h - 4, s - 1, opts.fill or S.C.ink, z)
	local inner = S.box(g, (kind == "para" or kind == "left") and s or 2, 2, w - 2 * s, h - 4, z)
	inner.ClipsDescendants = true
	S.tile(inner, "tex_rain", 0, 0, w, h, z)
	if opts.halftone ~= false then
		local ht = S.tile(inner, "tex_halftone", 0, h * 0.55, w * 0.4, h * 0.45, z, 0.1, 64)
		fade(ht, -35, 0, 1)
	end
	local content = S.box(g, 0, 0, w, h, z + 1, "Content")
	return g, content
end

-- the big notched frame: thick red border, thin gold line, dark rain-textured inside
function S.frame(parent, x, y, w, h, z)
	z = z or 1
	local g = S.box(parent, x, y, w, h, z, "HudFrame")
	local stepX = math.floor(w * 0.44)
	local function layer(inset, color)
		local c1, st, c2 = 30 - inset * 0.5, 26, 44 - inset * 0.5
		local X, Y, W, H = inset, inset, w - 2 * inset, h - 2 * inset
		S.tri(g, "LR", X, Y, c1, c1, color, z)
		S.rect(g, X, Y + c1 - 1, c1 + 1, H - c1 + 1, color, z)
		S.rect(g, X + c1 - 1, Y, stepX - c1 - inset + 2, H, color, z)
		S.tri(g, "LL", X + stepX - inset, Y, st, st, color, z)
		S.rect(g, X + stepX - inset, Y + st - 1, st + 1, H - st + 1, color, z)
		S.rect(g, X + stepX - inset + st - 1, Y + st, W - stepX + inset - st + 1, H - st - c2 + 1, color, z)
		S.rect(g, X + stepX - inset + st - 1, Y + H - c2, W - stepX + inset - st - c2 + 2, c2, color, z)
		S.tri(g, "UL", X + W - c2, Y + H - c2, c2, c2, color, z)
	end
	layer(0, S.C.red)
	layer(7, S.C.gold)
	layer(9, Color3.fromRGB(10, 8, 9))
	local inner = S.box(g, 9, 35, w - 18, h - 44 - 35, z, "Texture")
	inner.ClipsDescendants = true
	S.tile(inner, "tex_rain", 0, 0, w, h, z)
	fade(S.tile(g, "tex_halftone", w * 0.64, 35, w * 0.34, h * 0.4, z, 0, 64), 145, 0.1, 1)
	fade(S.tile(g, "tex_halftone", 12, h * 0.62, w * 0.3, h * 0.36, z, 0, 64), -35, 0.1, 1)
	return g
end

-- black brush slab with the screen title (top-left corner)
function S.slab(parent, title, sub)
	local g = S.box(parent, -10, -6, 580, 130, 20, "Title")
	S.brush(g, "slab", 0, 0, 600, 132, -3, 20)
	local t = S.title(g, 34, 14, 520, 60, S.upper(title), 58, { ZIndex = 21 })
	t.Rotation = -3
	local s = S.text(g, 150, 78, 420, 18, S.upper(sub), S.BODY, 13, Color3.fromRGB(214, 207, 200), { ZIndex = 22, Rotation = -3 })
	return g, t, s
end

-- ------------------------------------------------------------------ buttons
-- category button (Mochila style). returns an api with .button and .setSelected(bool)
function S.catButton(parent, x, y, w, h, iconKey, label, num, z)
	z = z or 5
	local b = new("TextButton", { Name = label, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = z, Parent = parent })
	local shapeGold = S.shape(b, "right", 0, 0, w, h, 16, S.C.gold, z)
	S.shape(b, "right", 2, 2, w - 4, h - 4, 15, S.C.ink2, z)
	local tex = S.box(b, 2, 2, w - 22, h - 4, z)
	tex.ClipsDescendants = true
	S.tile(tex, "tex_rain", 0, 0, w, h, z)
	local tint = S.rect(tex, 0, 0, w, h, S.C.red, z, 1)
	new("UIGradient", { Transparency = NumberSequence.new(0.55, 1), Parent = tint })
	local br = S.brush(b, "streak", w - h * 2.1, h * 0.2, h * 2.4, h * 0.55, -6, z + 1, 0.1)
	local sq = math.floor(h * 0.74)
	local ico = new("Frame", { Position = UDim2.fromOffset(12, (h - sq) / 2), Size = UDim2.fromOffset(sq, sq), BackgroundColor3 = S.C.ink, BorderSizePixel = 0, Rotation = -4, ZIndex = z + 2, Parent = b }, {
		new("UIStroke", { Color = S.C.gold, Thickness = 2 }),
	})
	local ig = S.icon(ico, iconKey, sq * 0.2, sq * 0.2, sq * 0.6, Color3.new(1, 1, 1), z + 3)
	local lbl = S.title(b, sq + 26, 0, w - sq - 40, h, S.upper(label), math.clamp(math.floor(h * 0.27), 15, 28), { ZIndex = z + 3 })
	if num then
		S.text(b, w - 70, 6, 46, 12, num, S.BODY, 10, S.C.mute, { ZIndex = z + 3, TextXAlignment = Enum.TextXAlignment.Right })
	end
	local api = { button = b, label = lbl, selected = false }
	local basePos = b.Position
	function api.setSelected(on)
		api.selected = on
		S.recolor(shapeGold, on and S.C.gold2 or S.C.gold)
		S.tween(tint, S.SNAP, { BackgroundTransparency = on and 0 or 1 })
		S.tween(ico, S.POP, { BackgroundColor3 = on and Color3.new(1, 1, 1) or S.C.ink, Rotation = on and -7 or -4 })
		ig.ImageColor3 = on and S.C.ink or Color3.new(1, 1, 1)
		S.tween(b, S.EASE_OUT, { Position = basePos + UDim2.fromOffset(on and 12 or 0, 0) })
		S.tween(br, S.EASE_OUT, { Size = UDim2.fromOffset(h * 2.4 * (on and 1.18 or 1), h * 0.55), ImageTransparency = on and 0 or 0.1 })
	end
	local function hover(on)
		if not api.selected then
			S.tween(b, S.SNAP, { Position = basePos + UDim2.fromOffset(on and 5 or 0, 0) })
		end
	end
	b.MouseEnter:Connect(function()
		hover(true)
		S.sfx("tick")
	end)
	b.MouseLeave:Connect(function()
		hover(false)
	end)
	b.SelectionGained:Connect(function()
		hover(true)
	end)
	b.SelectionLost:Connect(function()
		hover(false)
	end)
	return api
end

-- big action button (USAR / VOLTAR style)
function S.bigButton(parent, x, y, w, h, iconKey, label, key, z)
	z = z or 8
	local b = new("TextButton", { Name = label, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = z, Parent = parent })
	S.shape(b, "para", -10, -8, w + 14, h + 18, 22, S.C.red, z)
	S.shape(b, "right", 0, 0, w, h, 20, S.C.gold, z)
	S.shape(b, "right", 2, 2, w - 4, h - 4, 19, S.C.ink2, z)
	local tex = S.box(b, 2, 2, w - 24, h - 4, z)
	tex.ClipsDescendants = true
	S.tile(tex, "tex_rain", 0, 0, w, h, z)
	S.brush(b, "streak", w - h * 2.7, h * 0.3, h * 2.7, h * 0.6, -5, z + 1)
	local sq = math.floor(h * 0.7)
	local box = new("Frame", { Position = UDim2.fromOffset(h * 0.2, (h - sq) / 2), Size = UDim2.fromOffset(sq, sq), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Rotation = -3, ZIndex = z + 2, Parent = b }, {
		new("UIStroke", { Color = S.C.red, Thickness = 3 }),
	})
	S.icon(box, iconKey, sq * 0.22, sq * 0.22, sq * 0.56, S.C.ink, z + 3)
	local lbl = S.title(b, sq + h * 0.45, 0, w - sq - h * 0.6, h, S.upper(label), math.floor(h * 0.38), { ZIndex = z + 3 })
	if key then
		S.text(b, w - 120, 8, 90, 12, key, S.BODY, 11, S.C.mute, { ZIndex = z + 3, TextXAlignment = Enum.TextXAlignment.Right })
	end
	local sc = new("UIScale", { Parent = b })
	local base = b.Position
	b.MouseEnter:Connect(function()
		S.tween(b, S.SNAP, { Position = base + UDim2.fromOffset(-4, 0) })
		S.sfx("tick")
	end)
	b.MouseLeave:Connect(function()
		S.tween(b, S.SNAP, { Position = base })
		S.tween(sc, S.SNAP, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		S.tween(sc, TweenInfo.new(0.07), { Scale = 0.96 })
	end)
	b.MouseButton1Up:Connect(function()
		S.tween(sc, S.POP, { Scale = 1 })
	end)
	return b, lbl
end

function S.backButton(parent, onClick)
	local b = S.bigButton(parent, 18, 720 - 14 - 72, 250, 72, "arrow", "Voltar", "BACKSPACE", 30)
	b.Activated:Connect(function()
		S.sfx("close")
		onClick()
	end)
	return b
end

-- type chip (colour + glyph + name, never colour alone)
function S.chip(parent, x, y, typeKey, labelOverride, z)
	local t = S.TYPES[typeKey] or S.TYPES.normal
	local label = labelOverride or t[1]
	local w = 34 + (utf8.len(label) or #label) * 7
	z = z or 4
	local g = S.shape(parent, "para", x, y, w, 22, 5, t[2], z)
	S.icon(g, "t_" .. typeKey, 7, 4, 14, Color3.new(1, 1, 1), z + 1)
	S.text(g, 24, 0, w - 26, 22, S.upper(label), S.BODYB, 12, Color3.new(1, 1, 1), { ZIndex = z + 1 })
	return g, w
end

-- segmented bar; returns group and an api with set(fraction)
function S.bar(parent, x, y, w, h, color, frac, z)
	z = z or 4
	local g = S.shape(parent, "para", x, y, w, h, 4, Color3.fromRGB(42, 34, 37), z)
	local fill = S.rect(g, 3, 0, math.max(0, (w - 6) * math.clamp(frac, 0, 1)), h, color, z + 1)
	for i = 1, 3 do
		S.rect(g, 3 + (w - 6) * i / 4 - 1, 0, 2, h, S.C.ink, z + 2)
	end
	local api = {}
	function api.set(f)
		S.tween(fill, S.SLOW, { Size = UDim2.fromOffset(math.max(0, (w - 6) * math.clamp(f, 0, 1)), h) })
	end
	return g, api
end

-- toast at the bottom centre of a screen
function S.toast(screen, text)
	local old = screen:FindFirstChild("Toast")
	if old then
		old:Destroy()
	end
	local w = math.max(220, (utf8.len(text) or #text) * 10 + 60)
	local g = S.box(screen, 640 - w / 2, 656, w, 40, 60, "Toast")
	S.shape(g, "para", 0, 0, w, 40, 10, S.C.gold2, 60)
	S.text(g, 0, 0, w, 40, S.upper(text), S.DISPLAY, 18, Color3.fromRGB(20, 15, 0), { ZIndex = 61, TextXAlignment = Enum.TextXAlignment.Center })
	S.tween(g, S.EASE_OUT, { Position = UDim2.fromOffset(640 - w / 2, 590) })
	task.delay(1.8, function()
		if g.Parent then
			S.tween(g, S.EASE_OUT, { Position = UDim2.fromOffset(640 - w / 2, 740) })
			task.delay(0.3, function()
				g:Destroy()
			end)
		end
	end)
	return g
end

-- line between two points (used by the radar)
function S.line(parent, x1, y1, x2, y2, color, th, z, tr)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	return new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2), Size = UDim2.fromOffset(len, th),
		Rotation = math.deg(math.atan2(dy, dx)), BackgroundColor3 = color, BackgroundTransparency = tr or 0, BorderSizePixel = 0, ZIndex = z or 3, Parent = parent,
	})
end

-- ------------------------------------------------------------------ UI sounds (one sprite file, see PVHudConfig)
local sfxFolder
function S.sfx(name)
	local r = Config.UiSprite[name]
	if not r or Config.Sounds.ui == "rbxassetid://0" then
		return
	end
	if not sfxFolder then
		sfxFolder = new("Folder", { Name = "PVHudSfx", Parent = SoundService })
	end
	local s = new("Sound", { SoundId = Config.Sounds.ui, Volume = Config.UiVolume, Parent = sfxFolder })
	pcall(function()
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(r[1], r[2])
	end)
	s.TimePosition = r[1]
	s:Play()
	task.delay(r[2] - r[1] + 0.3, function()
		s:Destroy()
	end)
end

return S
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">PVMoves</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Tela de GOLPES: 4 slots fixos + lista de aprendidos e próximos desbloqueios.
-- Trocar: clique no slot e depois no golpe (ou o contrário), ou arraste golpe -> slot, slot -> golpe, slot -> slot.
local M = {}
M.__index = M

local CATS = { fisico = { "Físico", "c_fisico" }, especial = { "Especial", "c_especial" }, status = { "Status", "c_status" } }
local TYPE_ORDER = { "normal", "sombra", "martial", "fogo", "onirico", "raio", "agua", "vento", "terra" }

function M.new(hud)
	local self = setmetatable({ hud = hud, S = hud.S, D = hud.data }, M)
	self.armed, self.picked, self.typeF, self.catF = 0, nil, "all", "all"
	self.focus = { zone = "slots", i = 1 }
	self:build()
	return self
end

function M:build()
	local S = self.S
	local root = S.new("CanvasGroup", { Name = "Golpes", Size = UDim2.fromOffset(1280, 720), BackgroundTransparency = 1, Visible = false, Parent = self.hud.stage })
	self.root = root
	S.rect(root, 0, 0, 1280, 720, Color3.new(0, 0, 0), 0, 0.45)
	S.frame(root, 10, 88, 1262, 556, 1)
	S.slab(root, "Golpes", "Escolha 4 para a batalha")
	-- equipped
	local _, eq = S.panel(root, 30, 124, 462, 386, { kind = "right", z = 3 })
	S.title(eq, 18, 10, 200, 26, "EQUIPADOS", 22, { ZIndex = 6 })
	self.count = S.text(eq, 300, 12, 130, 20, "4 / 4", S.BODY, 12, S.C.dim, { ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Right })
	self.slotHost = S.box(eq, 14, 46, 420, 300, 5)
	self.ult = S.box(eq, 14, 334, 420, 40, 5)
	-- detail
	local _, det = S.panel(root, 30, 520, 462, 100, { kind = "para", slant = 16, z = 3 })
	self.det = S.box(det, 30, 10, 400, 82, 5)
	-- list
	local _, lst = S.panel(root, 508, 132, 742, 488, { kind = "left", slant = 18, z = 3 })
	self.filters = S.box(lst, 34, 12, 700, 56, 5)
	local hdr = S.box(lst, 44, 72, 670, 14, 5)
	for _, h in ipairs({ { 0, "NV" }, { 50, "GOLPE" }, { 440, "TIPO" }, { 530, "PODER" }, { 580, "PREC." }, { 634, "PP" } }) do
		S.text(hdr, h[1], 0, 60, 14, h[2], S.BODYB, 10, S.C.mute, { ZIndex = 6 })
	end
	self.list = S.new("ScrollingFrame", {
		Position = UDim2.fromOffset(26, 90), Size = UDim2.fromOffset(700, 386), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5,
		ScrollBarImageColor3 = S.C.red, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 6, Parent = lst,
	}, { S.new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }), S.new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingRight = UDim.new(0, 12) }) })
	S.backButton(root, function()
		self:cancel()
		self.hud.back()
	end)
	self:buildLearn()
	self:refresh()
end

function M:moveById(id)
	for _, m in ipairs(self.data.list) do
		if m.id == id then
			return m
		end
	end
end

-- ------------------------------------------------------------------ slots
function M:renderSlots()
	local S = self.S
	self.slotHost:ClearAllChildren()
	self.slots = {}
	for i = 1, 4 do
		local m = self:moveById(self.data.equipped[i])
		local y = (i - 1) * 74
		local b = S.new("TextButton", { Name = "Slot" .. i, Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(420, 66), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6, Parent = self.slotHost })
		b:SetAttribute("PVSlot", i)
		local out = S.shape(b, "para", 0, 0, 420, 66, 12, S.C.line, 6)
		S.shape(b, "para", 2, 2, 416, 62, 11, S.C.ink2, 6)
		S.brush(b, "streak", 250, 30, 170, 34, -4, 7, 0.7)
		S.title(b, 8, 0, 40, 66, tostring(i), 34, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = S.C.dim })
		if m then
			local tc = (S.TYPES[m.type] or S.TYPES.normal)[2]
			S.shape(b, "para", 52, 10, 7, 46, 2, tc, 8)
			S.title(b, 68, 8, 220, 24, S.upper(m.name), 20, { ZIndex = 8 })
			local _, cw = S.chip(b, 68, 36, m.type, nil, 8)
			S.icon(b, CATS[m.cat][2], 76 + cw, 40, 14, S.C.dim, 8)
			S.text(b, 94 + cw, 36, 80, 22, S.upper(CATS[m.cat][1]), S.BODYB, 11, S.C.dim, { ZIndex = 8 })
			local nums = { { "PODER", m.power and (tostring(m.power) .. (m.hits and "×" .. m.hits or "")) or "—" }, { "PREC", m.acc and tostring(m.acc) or "—" }, { "PP", tostring(m.pp) } }
			for k, n in ipairs(nums) do
				S.text(b, 268 + (k - 1) * 46, 14, 44, 12, n[1], S.BODY, 10, S.C.mute, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
				S.text(b, 268 + (k - 1) * 46, 28, 44, 20, n[2], S.BODYB, 16, S.C.bone, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
			end
		end
		b.Activated:Connect(function()
			if not self.dragging then
				self:armSlot(i)
			end
		end)
		b.MouseEnter:Connect(function()
			self:setFocus("slots", i)
		end)
		self:hookDrag(b, { kind = "slot", i = i })
		self.slots[i] = { button = b, outline = out, base = b.Position }
	end
	local S2 = self.S
	self.ult:ClearAllChildren()
	local u = self.D.getFighter().ultimate
	if u then
		S2.shape(self.ult, "para", 0, 0, 420, 40, 10, Color3.fromRGB(61, 42, 6), 6)
		S2.shape(self.ult, "para", 14, 11, 76, 18, 4, S2.C.gold2, 7)
		S2.text(self.ult, 18, 11, 70, 18, "ULTIMATE", S2.BODYB, 10, Color3.fromRGB(20, 15, 0), { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center })
		S2.title(self.ult, 100, 0, 200, 40, S.upper(u.name), 18, { ZIndex = 8, TextColor3 = S2.C.gold2 })
		S2.text(self.ult, 280, 0, 124, 40, u.note or "", S2.BODY, 11, Color3.fromRGB(217, 199, 154), { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = true })
	end
end

-- ------------------------------------------------------------------ filters + list
function M:renderFilters()
	local S = self.S
	self.filters:ClearAllChildren()
	self.filterButtons = {}
	local present = {}
	for _, m in ipairs(self.data.list) do
		present[m.type] = true
	end
	local x = 0
	S.text(self.filters, x, 0, 34, 24, "TIPO", S.BODYB, 10, S.C.mute, { ZIndex = 7 })
	x = 36
	local function fbtn(label, val, color, row, isCat)
		local w = 22 + (utf8.len(label) or #label) * 7
		local b = S.new("TextButton", { Position = UDim2.fromOffset(x, row), Size = UDim2.fromOffset(w, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 7, Parent = self.filters })
		local on = (isCat and self.catF or self.typeF) == val
		S.shape(b, "para", 0, 0, w, 24, 5, on and (color or S.C.bone) or Color3.fromRGB(36, 29, 32), 7)
		S.text(b, 0, 0, w, 24, S.upper(label), S.BODYB, 11, on and (color and Color3.new(1, 1, 1) or S.C.ink) or S.C.dim, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center })
		b.Activated:Connect(function()
			if isCat then
				self.catF = val
			else
				self.typeF = val
			end
			S.sfx("tick")
			self:renderFilters()
			self:renderRows()
		end)
		x += w + 6
		table.insert(self.filterButtons, b)
	end
	fbtn("Todos", "all", nil, 0)
	for _, t in ipairs(TYPE_ORDER) do
		if present[t] then
			fbtn(S.TYPES[t][1], t, S.TYPES[t][2], 0)
		end
	end
	x = 0
	S.text(self.filters, x, 30, 70, 24, "CATEGORIA", S.BODYB, 10, S.C.mute, { ZIndex = 7 })
	x = 72
	fbtn("Todas", "all", nil, 30, true)
	for _, k in ipairs({ "fisico", "especial", "status" }) do
		fbtn(CATS[k][1], k, nil, 30, true)
	end
end

function M:renderRows()
	local S = self.S
	for _, c in ipairs(self.list:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	self.rows = {}
	local learned, locked = {}, {}
	for _, m in ipairs(self.data.list) do
		if (self.typeF == "all" or m.type == self.typeF) and (self.catF == "all" or m.cat == self.catF) then
			table.insert(m.lv <= self.data.level and learned or locked, m)
		end
	end
	local order = 0
	local function section(txt)
		order += 1
		S.text(self.list, 0, 0, 660, 20, txt, S.BODYB, 10, S.C.gold, { LayoutOrder = order, ZIndex = 7 })
	end
	local function row(m, lock)
		order += 1
		local eqI = table.find(self.data.equipped, m.id)
		local tc = (S.TYPES[m.type] or S.TYPES.normal)[2]
		local b = S.new("TextButton", { Name = m.id, LayoutOrder = order, Size = UDim2.fromOffset(660, 56), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 7, Parent = self.list })
		local out = S.shape(b, "para", 0, 0, 660, 56, 8, lock and Color3.fromRGB(20, 16, 18) or Color3.fromRGB(28, 21, 24), 7)
		S.shape(b, "para", 2, 2, 656, 52, 7, lock and Color3.fromRGB(20, 16, 18) or Color3.fromRGB(28, 21, 24), 7)
		S.shape(b, "para", 8, 0, 6, 56, 2, lock and Color3.fromRGB(58, 50, 54) or tc, 8)
		local dimC = lock and Color3.fromRGB(107, 98, 93) or S.C.bone
		S.text(b, 16, 8, 36, 12, "NV", S.BODYB, 10, S.C.dim, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center })
		S.title(b, 16, 22, 36, 24, tostring(m.lv), 20, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = dimC })
		local nm = S.title(b, 62, 7, 360, 22, S.upper(m.name), 19, { ZIndex = 9, TextColor3 = dimC })
		local nameW = nm.TextBounds.X
		if nameW <= 0 then
			nameW = (utf8.len(m.name) or #m.name) * 11 -- TextBounds is 0 until the text is laid out
		end
		local tx = 62 + nameW + 10
		if eqI then
			S.shape(b, "right", tx, 10, 104, 16, 3, Color3.fromRGB(45, 37, 40), 9)
			S.icon(b, "check", tx + 5, 12, 12, S.C.bone, 10)
			S.text(b, tx + 20, 10, 84, 16, "EQUIPADO · " .. eqI, S.BODYB, 10, S.C.bone, { ZIndex = 10 })
			tx += 110
		end
		if m.isNew and not lock then
			S.shape(b, "right", tx, 10, 50, 16, 3, S.C.red, 9)
			S.text(b, tx, 10, 46, 16, "NOVO", S.BODYB, 10, Color3.new(1, 1, 1), { ZIndex = 10, TextXAlignment = Enum.TextXAlignment.Center })
		end
		if lock then
			S.icon(b, "lock", 62, 33, 13, S.C.gold, 9)
			S.text(b, 80, 31, 330, 16, "Desbloqueia no nível " .. m.lv, S.BODYB, 12, S.C.gold, { ZIndex = 9 })
		else
			S.text(b, 62, 31, 360, 16, m.effect or "", S.BODY, 12.5, S.C.dim, { ZIndex = 9, TextTruncate = Enum.TextTruncate.AtEnd })
		end
		S.chip(b, 432, 8, m.type, nil, 9)
		S.icon(b, CATS[m.cat][2], 436, 34, 13, S.C.dim, 9)
		S.text(b, 452, 32, 70, 14, S.upper(CATS[m.cat][1]), S.BODYB, 10, S.C.dim, { ZIndex = 9 })
		local nums = { m.power and (tostring(m.power) .. (m.hits and "×" .. m.hits or "")) or "—", m.acc and tostring(m.acc) or "—", tostring(m.pp) }
		for k, n in ipairs(nums) do
			S.text(b, 516 + (k - 1) * 50, 10, 44, 20, n, S.BODYB, 16, dimC, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right })
			S.text(b, 516 + (k - 1) * 50, 32, 44, 12, ({ "PODER", "PREC", "PP" })[k], S.BODY, 9, S.C.mute, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right })
		end
		local r = { button = b, move = m, lock = lock, outline = out, base = UDim2.fromOffset(0, 0) }
		b.Activated:Connect(function()
			if not self.dragging then
				self:pickMove(m)
			end
		end)
		b.MouseEnter:Connect(function()
			self:setFocus("list", table.find(self.rows, r))
		end)
		if not lock then
			self:hookDrag(b, { kind = "row", id = m.id })
		end
		table.insert(self.rows, r)
	end
	if #learned > 0 then
		section("APRENDIDOS · " .. #learned)
		for _, m in ipairs(learned) do
			row(m, false)
		end
	end
	if #locked > 0 then
		section("PRÓXIMOS DESBLOQUEIOS")
		for _, m in ipairs(locked) do
			row(m, true)
		end
	end
end

function M:renderDetail(m)
	local S = self.S
	self.det:ClearAllChildren()
	if not m then
		return
	end
	S.title(self.det, 0, 0, 250, 26, S.upper(m.name), 23, { ZIndex = 6 })
	local _, cw = S.chip(self.det, 260, 3, m.type, nil, 6)
	S.text(self.det, 268 + cw, 3, 100, 22, S.upper(CATS[m.cat][1]), S.BODYB, 11, S.C.dim, { ZIndex = 6 })
	local lock = m.lv > self.data.level
	local txt = (lock and ("Desbloqueia no nível " .. m.lv .. ". ") or "") .. (m.effect or "") .. "  Poder " .. (m.power or "—") .. " · Precisão " .. (m.acc or "—") .. " · PP " .. m.pp .. " · Aprendido no nível " .. m.lv .. "."
	S.text(self.det, 0, 32, 400, 48, txt, S.BODY, 14, Color3.fromRGB(221, 212, 203), { ZIndex = 6, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
end

-- ------------------------------------------------------------------ state
function M:refresh()
	self.data = self.D.getMoves()
	local n = 0
	for i = 1, 4 do
		if self.data.equipped[i] then
			n += 1
		end
	end
	self.count.Text = n .. " / 4"
	self:renderSlots()
	self:renderFilters()
	self:renderRows()
	self:decorate()
end

function M:decorate()
	local S = self.S
	for i, s in ipairs(self.slots) do
		local armed = self.armed == i
		local focus = self.focus.zone == "slots" and self.focus.i == i
		S.recolor(s.outline, armed and S.C.gold2 or focus and S.C.bone or S.C.line)
		S.tween(s.button, S.SNAP, { Position = s.base + UDim2.fromOffset((armed or focus) and 6 or 0, 0) })
	end
	for i, r in ipairs(self.rows or {}) do
		local focus = self.focus.zone == "list" and self.focus.i == i
		local sel = self.picked == r.move.id
		S.recolor(r.outline, sel and S.C.gold2 or focus and S.C.bone or (r.lock and Color3.fromRGB(20, 16, 18) or Color3.fromRGB(28, 21, 24)))
		S.tween(r.button, S.FOCUS, { Position = UDim2.fromOffset(focus and 5 or 0, 0) })
	end
	if self.focus.zone == "slots" then
		self:renderDetail(self:moveById(self.data.equipped[self.focus.i]))
	elseif self.rows and self.rows[self.focus.i] then
		self:renderDetail(self.rows[self.focus.i].move)
	end
end

function M:setFocus(zone, i)
	if not i then
		return
	end
	if self.focus.zone ~= zone or self.focus.i ~= i then
		self.focus = { zone = zone, i = i }
		self:decorate()
	end
end

function M:cancel()
	self.armed, self.picked = 0, nil
end

function M:armSlot(i)
	local S = self.S
	if self.picked then
		return self:equip(self.picked, i)
	end
	self.armed = self.armed == i and 0 or i
	S.sfx("select")
	if self.armed > 0 then
		S.toast(self.root, "Escolha o golpe para o slot " .. i)
	end
	self:decorate()
end

function M:pickMove(m)
	local S = self.S
	if m.lv > self.data.level then
		S.sfx("deny")
		S.toast(self.root, "Desbloqueia no nível " .. m.lv)
		return
	end
	if self.armed > 0 then
		return self:equip(m.id, self.armed)
	end
	self.picked = self.picked ~= m.id and m.id or nil
	S.sfx("select")
	if self.picked then
		S.toast(self.root, "Escolha o slot (1–4) para " .. m.name)
	end
	self.focus = { zone = "slots", i = 1 }
	self:decorate()
end

function M:equip(id, slot)
	local S = self.S
	local m = self:moveById(id)
	if not m or m.lv > self.data.level then
		return
	end
	if self.D.equipMove(slot, id) then
		self:cancel()
		self:refresh()
		self.focus = { zone = "slots", i = slot }
		self:decorate()
		local s = self.slots[slot]
		local flash = S.rect(s.button, 0, 0, 420, 66, Color3.new(1, 1, 1), 20, 0.2)
		S.tween(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
		task.delay(0.55, function()
			flash:Destroy()
		end)
		S.sfx("save")
		S.toast(self.root, "Slot " .. slot .. ": " .. m.name .. " · conjunto salvo")
	end
end

-- ------------------------------------------------------------------ drag and drop
function M:hookDrag(button, from)
	button.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
			return
		end
		self.pending = { from = from, pos = input.Position, t0 = os.clock(), touch = t == Enum.UserInputType.Touch, src = button }
	end)
end

function M:startDrag(p)
	local S = self.S
	local gui = self.hud.dragGui
	local src = p.src
	local ghost = src:Clone()
	for _, d in ipairs(ghost:GetDescendants()) do
		if d:IsA("GuiObject") then
			d.ZIndex += 100
		end
	end
	ghost.Size = src.Size
	ghost.Rotation = -2
	S.new("UIScale", { Scale = self.hud.scale(), Parent = ghost })
	ghost.Parent = gui
	self.dragging = { ghost = ghost, from = p.from, off = Vector2.new(p.pos.X, p.pos.Y) - src.AbsolutePosition }
	src.Visible = true
	S.sfx("select")
end

function M:dropTarget(pos)
	local objs = self.hud.playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
	for _, o in ipairs(objs) do
		local x = o
		while x and x ~= self.root do
			if x:GetAttribute("PVSlot") then
				return { kind = "slot", i = x:GetAttribute("PVSlot") }
			end
			if x.Parent == self.list and x:IsA("TextButton") then
				local m = self:moveById(x.Name)
				if m and m.lv <= self.data.level then
					return { kind = "row", id = m.id }
				end
			end
			x = x.Parent
		end
	end
end

function M:inputChanged(input)
	local p = self.pending
	if p and not self.dragging then
		local d = (Vector2.new(input.Position.X, input.Position.Y) - Vector2.new(p.pos.X, p.pos.Y)).Magnitude
		if p.touch and os.clock() - p.t0 < 0.22 then
			if d > 10 then
				self.pending = nil
			end
			return
		end
		if d > 6 then
			self:startDrag(p)
		end
	end
	if self.dragging then
		local g = self.dragging
		g.ghost.Position = UDim2.fromOffset(input.Position.X - g.off.X, input.Position.Y - g.off.Y)
	end
end

function M:inputEnded(input)
	self.pending = nil
	local g = self.dragging
	if not g then
		return
	end
	g.ghost:Destroy()
	local t = self:dropTarget(input.Position)
	local f = g.from
	task.defer(function()
		self.dragging = nil
	end)
	self:cancel()
	if not t then
		self.S.sfx("close")
		self:decorate()
		return
	end
	if f.kind == "row" and t.kind == "slot" then
		self:equip(f.id, t.i)
	elseif f.kind == "slot" and t.kind == "row" then
		self:equip(t.id, f.i)
	elseif f.kind == "slot" and t.kind == "slot" and f.i ~= t.i then
		self.D.swapSlots(f.i, t.i)
		self:refresh()
		self.S.sfx("save")
		self.S.toast(self.root, "Slots " .. f.i .. " e " .. t.i .. " trocados · conjunto salvo")
	end
end

-- ------------------------------------------------------------------ level-up banner: "Equipar agora" / "Depois"
function M:buildLearn()
	local S = self.S
	local g = S.box(self.root, 740, -150, 520, 128, 40, "Learn")
	S.shape(g, "para", -6, -6, 532, 140, 16, S.C.red, 40)
	local _, c = S.panel(g, 0, 0, 520, 128, { kind = "para", slant = 14, z = 41, outline = S.C.gold2 })
	self.lnCap = S.text(c, 30, 14, 300, 14, "", S.BODYB, 11, S.C.gold2, { ZIndex = 45 })
	self.lnName = S.title(c, 30, 34, 300, 40, "", 32, { ZIndex = 45 })
	self.lnInfo = S.text(c, 30, 82, 300, 20, "", S.BODY, 13, S.C.dim, { ZIndex = 45 })
	local now = S.bigButton(c, 330, 16, 170, 46, "play", "Equipar", "ENTER", 46)
	local later = S.bigButton(c, 330, 70, 170, 42, "x", "Depois", "BKSP", 46)
	now.Activated:Connect(function()
		self:closeLearn(true)
	end)
	later.Activated:Connect(function()
		self:closeLearn(false)
	end)
	self.learnBox = g
end

-- call when the fighter learns a move (after a level up); the move must already be in PVData.getMoves().list
function M:learn(moveId)
	local S = self.S
	self:refresh()
	local m = self:moveById(moveId)
	if not m then
		return
	end
	m.isNew = true
	self.learning = m
	self.lnCap.Text = "NÍVEL " .. m.lv .. " · NOVO GOLPE APRENDIDO"
	self.lnName.Text = S.upper(m.name)
	self.lnInfo.Text = (S.TYPES[m.type] or S.TYPES.normal)[1] .. " · Poder " .. (m.power or "—") .. " · PP " .. m.pp
	S.tween(self.learnBox, S.SLOW, { Position = UDim2.fromOffset(740, 18) })
	S.sfx("save")
	self:renderRows()
end

function M:closeLearn(now)
	local S = self.S
	S.tween(self.learnBox, S.EASE_OUT, { Position = UDim2.fromOffset(740, -150) })
	local m = self.learning
	self.learning = nil
	if not m then
		return
	end
	if now then
		self.picked, self.armed = m.id, 0
		self.focus = { zone = "slots", i = 1 }
		self:decorate()
		S.toast(self.root, "Escolha o slot para " .. m.name)
	else
		S.toast(self.root, m.name .. " ficou na lista de aprendidos")
	end
end

-- ------------------------------------------------------------------ keys: up/down/left/right/ok/back/lb/rb/1-4
function M:key(k)
	if self.learning then
		if k == "ok" then
			self:closeLearn(true)
		elseif k == "back" then
			self:closeLearn(false)
		end
		return true
	end
	local f = self.focus
	local n = f.zone == "slots" and 4 or #self.rows
	if k == "down" then
		f.i = math.min(n, f.i + 1)
	elseif k == "up" then
		f.i = math.max(1, f.i - 1)
	elseif k == "right" and f.zone == "slots" then
		self.focus = { zone = "list", i = 1 }
	elseif k == "left" and f.zone == "list" then
		self.focus = { zone = "slots", i = math.min(4, f.i) }
	elseif k == "ok" then
		if f.zone == "slots" then
			self:armSlot(f.i)
		elseif self.rows[f.i] then
			self:pickMove(self.rows[f.i].move)
		end
		return true
	elseif k == "back" then
		if self.armed > 0 or self.picked then
			self:cancel()
			self.S.toast(self.root, "Troca cancelada")
			self:decorate()
			return true
		end
		return false
	elseif k == "lb" or k == "rb" then
		local list = { "all" }
		for _, t in ipairs(TYPE_ORDER) do
			for _, m in ipairs(self.data.list) do
				if m.type == t then
					table.insert(list, t)
					break
				end
			end
		end
		local i = table.find(list, self.typeF) or 1
		self.typeF = list[(i - 1 + (k == "rb" and 1 or -1)) % #list + 1]
		self:renderFilters()
		self:renderRows()
		return true
	elseif k == "1" or k == "2" or k == "3" or k == "4" then
		self:armSlot(tonumber(k))
		return true
	else
		return false
	end
	self.S.sfx("tick")
	self:decorate()
	if self.focus.zone == "list" and self.rows[self.focus.i] then
		local b = self.rows[self.focus.i].button
		local top = b.AbsolutePosition.Y - self.list.AbsolutePosition.Y
		if top < 0 or top + b.AbsoluteSize.Y > self.list.AbsoluteSize.Y then
			self.list.CanvasPosition = Vector2.new(0, math.max(0, self.list.CanvasPosition.Y + top - 40))
		end
	end
	return true
end

function M:onShow()
	self:refresh()
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">PVFicha</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Tela FICHA DO LUTADOR (layout igual ao da Mochila): categorias à esquerda, conteúdo no meio,
-- retrato + nome + barras à direita, botão de ação grande embaixo à direita.
local F = {}
F.__index = F

local TABS = {
	{ "Status", "statusic", "Distribuir" }, { "Golpes", "i_fight", "Editar golpes" }, { "Talento", "talent", "Melhorar" },
	{ "Item", "item", "Equipar item" }, { "Passivas", "passive", nil },
}

function F.new(hud)
	local self = setmetatable({ hud = hud, S = hud.S, D = hud.data, tab = 1 }, F)
	self:build()
	return self
end

function F:build()
	local S = self.S
	local root = S.new("CanvasGroup", { Name = "Ficha", Size = UDim2.fromOffset(1280, 720), BackgroundTransparency = 1, Visible = false, Parent = self.hud.stage })
	self.root = root
	S.rect(root, 0, 0, 1280, 720, Color3.new(0, 0, 0), 0, 0.45)
	S.frame(root, 10, 88, 1262, 556, 1)
	S.slab(root, "Ficha", "Do lutador")
	self.cats = {}
	for i, t in ipairs(TABS) do
		local c = S.catButton(root, 28, 122 + (i - 1) * 96, 258, 84, t[2], t[1], "0" .. i, 6)
		c.button.Activated:Connect(function()
			self:setTab(i)
		end)
		self.cats[i] = c
	end
	local _, main = S.panel(root, 318, 122, 548, 496, { kind = "para", slant = 18, z = 3 })
	self.main = S.box(main, 40, 16, 470, 464, 6, "Pane")
	-- portrait with the red splash behind
	self.art = S.box(root, 884, 120, 370, 300, 4, "Art")
	S.brush(self.art, "splash", -40, -10, 440, 310, 0, 4)
	self.portrait = S.box(self.art, 70, 30, 230, 270, 5)
	S.text(self.art, 200, 280, 164, 16, "RETRATO 3D DO LUTADOR", S.BODYB, 10, S.C.dim, { ZIndex = 7, TextXAlignment = Enum.TextXAlignment.Right })
	local info = S.box(root, 890, 406, 362, 200, 6, "Info")
	self.info = info
	S.brush(info, "under", -18, 30, 390, 30, 0, 6)
	self.name = S.title(info, 0, 0, 362, 40, "", 36, { ZIndex = 8 })
	self.lv = S.title(info, 0, 50, 90, 22, "", 18, { ZIndex = 8, TextColor3 = S.C.gold2 })
	self.chipHost = S.box(info, 90, 50, 200, 22, 8)
	self.bars = {}
	for i, b in ipairs({ { "HP", Color3.fromRGB(227, 24, 47) }, { "EN", Color3.fromRGB(45, 127, 224) }, { "XP", Color3.fromRGB(245, 197, 66) } }) do
		local y = 80 + (i - 1) * 22
		S.text(info, 0, y, 30, 14, b[1], S.BODYB, 13, S.C.dim, { ZIndex = 8 })
		local _, api = S.bar(info, 32, y + 2, 236, 12, b[2], 0, 8)
		local v = S.text(info, 272, y, 90, 14, "000 / 000", S.BODYB, 13, S.C.bone, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
		self.bars[i] = { api = api, text = v }
	end
	local nick = S.catButton(info, 0, 148, 176, 56, "i_profile", "Apelido", nil, 8)
	nick.button.Activated:Connect(function()
		self.D.setNickname()
	end)
	self.fav = S.catButton(info, 186, 148, 176, 56, "star", "Favoritar", nil, 8)
	self.fav.button.Activated:Connect(function()
		local f = self.D.getFighter()
		self.D.setFavorite(not f.favorite)
		self:refresh()
		S.sfx("select")
		S.toast(self.root, self.D.getFighter().favorite and "Lutador favoritado" or "Removido dos favoritos")
	end)
	self.act, self.actLabel = S.bigButton(root, 880, 720 - 16 - 92, 380, 92, "play", "Editar", "ENTER", 30)
	self.act.Activated:Connect(function()
		self:action()
	end)
	S.backButton(root, function()
		if self.drawer then
			return self:closeDrawer()
		end
		self.hud.back()
	end)
	self:refresh()
end

function F:refresh()
	local S = self.S
	local f = self.D.getFighter()
	self.f = f
	self.name.Text = S.upper(f.name)
	self.lv.Text = "NV " .. f.level
	self.chipHost:ClearAllChildren()
	S.chip(self.chipHost, 0, 0, f.typeKey, nil, 8)
	for i, v in ipairs({ f.hp, f.en, f.xp }) do
		local cur, max = math.floor(v[1] + 0.5), math.floor(v[2] + 0.5)
		self.bars[i].api.set(max > 0 and cur / max or 0)
		self.bars[i].text.Text = cur .. " / " .. max
	end
	self.fav.setSelected(f.favorite)
	self.portrait:ClearAllChildren()
	if f.portraitModel then
		local vf = S.new("ViewportFrame", { Size = UDim2.fromOffset(230, 270), BackgroundTransparency = 1, ZIndex = 5, Parent = self.portrait })
		local m = f.portraitModel:Clone()
		m.Parent = vf
		local cf, size = m:GetBoundingBox()
		local cam = S.new("Camera", { FieldOfView = 30, Parent = vf })
		cam.CFrame = CFrame.new(cf.Position + cf.LookVector * size.Y * 2.2 + Vector3.new(0, size.Y * 0.2, 0), cf.Position + Vector3.new(0, size.Y * 0.2, 0))
		vf.CurrentCamera = cam
	elseif f.portrait then
		S.new("ImageLabel", { Size = UDim2.fromOffset(230, 270), BackgroundTransparency = 1, Image = f.portrait, ScaleType = Enum.ScaleType.Fit, ZIndex = 5, Parent = self.portrait })
	else
		S.new("Frame", { Position = UDim2.fromOffset(69, 20), Size = UDim2.fromOffset(92, 92), BackgroundColor3 = Color3.fromRGB(5, 3, 4), ZIndex = 5, Parent = self.portrait }, { S.new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		S.new("Frame", { Position = UDim2.fromOffset(15, 130), Size = UDim2.fromOffset(200, 180), BackgroundColor3 = Color3.fromRGB(5, 3, 4), ZIndex = 5, Parent = self.portrait }, { S.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	end
	self:setTab(self.tab, true)
end

function F:setTab(i, quiet)
	local S = self.S
	self.tab = (i - 1) % #TABS + 1
	for k, c in ipairs(self.cats) do
		c.setSelected(k == self.tab)
	end
	local act = TABS[self.tab][3]
	self.act.Visible = act ~= nil
	if act then
		self.actLabel.Text = S.upper(self.tab == 4 and self.f.item and "Trocar item" or act)
	end
	self.main:ClearAllChildren()
	self.drawer = nil
	local pane = S.box(self.main, 14, 0, 470, 464, 6)
	S.tween(pane, S.EASE_OUT, { Position = UDim2.fromOffset(0, 0) })
	local builders = { self.paneStatus, self.paneMoves, self.paneTalent, self.paneItem, self.panePassives }
	builders[self.tab](self, pane)
	if not quiet then
		S.sfx("tick")
	end
end

local function header(S, pane, title, cap)
	S.title(pane, 0, 0, 300, 30, S.upper(title), 28, { ZIndex = 8 })
	S.text(pane, 250, 8, 220, 14, S.upper(cap), S.BODYB, 10, S.C.mute, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
end

function F:paneStatus(pane)
	local S = self.S
	header(S, pane, "Atributos", "Base + bônus")
	local stats = self.f.stats
	-- radar: grid rings, spokes, base outline (red) and base+bonus outline (green), diamonds on the points
	local cx, cy, R, n = 125, 170, 92, #stats
	local function pt(i, r)
		local a = -math.pi / 2 + (i - 1) * 2 * math.pi / n
		return cx + math.cos(a) * r, cy + math.sin(a) * r
	end
	for _, k in ipairs({ 0.25, 0.5, 0.75, 1 }) do
		for i = 1, n do
			local x1, y1 = pt(i, R * k)
			local x2, y2 = pt(i % n + 1, R * k)
			S.line(pane, x1, y1, x2, y2, Color3.fromRGB(58, 48, 52), 1, 7)
		end
	end
	for i = 1, n do
		local x, y = pt(i, R)
		S.line(pane, cx, cy, x, y, Color3.fromRGB(58, 48, 52), 1, 7)
	end
	for layer = 1, 2 do
		for i = 1, n do
			local j = i % n + 1
			local vi = stats[i][2] + (layer == 2 and stats[i][3] or 0)
			local vj = stats[j][2] + (layer == 2 and stats[j][3] or 0)
			local x1, y1 = pt(i, R * vi / 100)
			local x2, y2 = pt(j, R * vj / 100)
			S.line(pane, x1, y1, x2, y2, layer == 1 and S.C.red or S.C.ok, 2, 8, layer == 2 and 0.3 or 0)
		end
	end
	for i, st in ipairs(stats) do
		local x, y = pt(i, R * st[2] / 100)
		S.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(9, 9), Rotation = 45, BackgroundColor3 = S.C.gold2, BorderSizePixel = 0, ZIndex = 9, Parent = pane }, { S.new("UIStroke", { Color = S.C.ink, Thickness = 2 }) })
		local lx, ly = pt(i, R + 26)
		S.text(pane, lx - 50, ly - 16, 100, 14, S.upper(st[1]), S.BODYB, 11, S.C.dim, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center })
		S.title(pane, lx - 50, ly - 2, 100, 18, tostring(st[2] + st[3]), 17, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center })
	end
	-- rows
	for i, st in ipairs(stats) do
		local y = 44 + (i - 1) * 56
		local g = S.shape(pane, "para", 256, y, 214, 48, 6, Color3.fromRGB(29, 22, 25), 7)
		S.text(g, 14, 6, 110, 16, S.upper(st[1]), S.BODYB, 12, S.C.dim, { ZIndex = 8 })
		S.title(g, 120, 3, 44, 22, tostring(st[2] + st[3]), 20, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
		S.text(g, 166, 6, 36, 16, st[3] > 0 and ("+" .. st[3]) or "—", S.BODYB, 12, st[3] > 0 and S.C.ok or S.C.mute, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
		S.rect(g, 14, 32, 186, 7, Color3.fromRGB(42, 34, 37), 8)
		S.rect(g, 14, 32, 186 * st[2] / 100, 7, S.C.red, 9)
		if st[3] > 0 then
			S.rect(g, 14 + 186 * st[2] / 100, 32, 186 * st[3] / 100, 7, S.C.ok, 9)
		end
	end
	S.rect(pane, 0, 330, 12, 8, S.C.red, 8)
	S.text(pane, 18, 327, 60, 14, "Base", S.BODY, 12, S.C.dim, { ZIndex = 8 })
	S.rect(pane, 70, 330, 12, 8, S.C.ok, 8)
	S.text(pane, 88, 327, 200, 14, "Bônus de item e talento", S.BODY, 12, S.C.dim, { ZIndex = 8 })
	S.text(pane, 280, 430, 120, 24, "Pontos livres", S.BODY, 13, S.C.dim, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
	S.title(pane, 404, 430, 60, 24, tostring(self.f.freePoints or 0), 22, { ZIndex = 8, TextColor3 = S.C.gold2, TextXAlignment = Enum.TextXAlignment.Right })
end

function F:paneMoves(pane)
	local S = self.S
	header(S, pane, "Golpes", "4 slots de combate")
	local mv = self.D.getMoves()
	local byId = {}
	for _, m in ipairs(mv.list) do
		byId[m.id] = m
	end
	for i = 1, 4 do
		local m = byId[mv.equipped[i]]
		local y = 44 + (i - 1) * 84
		S.shape(pane, "para", 0, y, 470, 76, 12, m and S.C.gold or Color3.fromRGB(74, 61, 66), 7)
		S.shape(pane, "para", 2, y + 2, 466, 72, 11, Color3.fromRGB(22, 17, 19), 7)
		S.brush(pane, "streak", 300, y + 36, 170, 34, -4, 8, 0.7)
		S.title(pane, 10, y, 40, 76, tostring(i), 34, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center })
		if m then
			S.shape(pane, "para", 56, y + 14, 7, 48, 2, (S.TYPES[m.type] or S.TYPES.normal)[2], 9)
			S.title(pane, 74, y + 12, 250, 24, S.upper(m.name), 20, { ZIndex = 9 })
			S.chip(pane, 74, y + 42, m.type, nil, 9)
			S.text(pane, 330, y + 14, 60, 12, "PODER", S.BODY, 10, S.C.mute, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right })
			S.text(pane, 330, y + 28, 60, 20, m.power and tostring(m.power) or "—", S.BODYB, 17, S.C.bone, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right })
			S.text(pane, 392, y + 14, 50, 12, "PP", S.BODY, 10, S.C.mute, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right })
			S.text(pane, 392, y + 28, 50, 20, tostring(m.pp), S.BODYB, 17, S.C.bone, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right })
		else
			S.text(pane, 56, y, 30, 76, "+", S.BODY, 30, S.C.mute, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center })
			S.title(pane, 92, y + 14, 200, 24, "VAGO", 20, { ZIndex = 9, TextColor3 = Color3.fromRGB(141, 133, 124) })
			S.text(pane, 92, y + 40, 200, 16, "Adicione um golpe.", S.BODY, 12, S.C.dim, { ZIndex = 9 })
		end
	end
	local u = self.f.ultimate
	if u then
		S.shape(pane, "para", 0, 386, 470, 50, 10, Color3.fromRGB(61, 42, 6), 7)
		S.shape(pane, "para", 16, 402, 76, 18, 4, S.C.gold2, 8)
		S.text(pane, 20, 402, 70, 18, "ULTIMATE", S.BODYB, 10, Color3.fromRGB(20, 15, 0), { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center })
		S.title(pane, 104, 386, 240, 50, S.upper(u.name), 19, { ZIndex = 9, TextColor3 = S.C.gold2 })
		S.text(pane, 320, 386, 136, 50, u.note or "", S.BODY, 11, Color3.fromRGB(217, 199, 154), { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = true })
	end
end

function F:paneTalent(pane)
	local S = self.S
	header(S, pane, "Talento", "Habilidade única")
	local t = self.f.talent
	S.brush(pane, "splash", -30, 40, 220, 190, 0, 7)
	local em = S.box(pane, 20, 60, 130, 146, 8)
	S.shape(em, "para", 0, 0, 130, 146, 10, S.C.gold, 8)
	S.shape(em, "para", 3, 3, 124, 140, 9, S.C.ink, 8)
	S.icon(em, "talent", 25, 33, 80, S.C.gold2, 9)
	S.title(pane, 180, 50, 290, 36, S.upper(t.name), 30, { ZIndex = 9 })
	for k = 1, t.maxRank do
		S.shape(pane, "para", 180 + (k - 1) * 28, 96, 24, 9, 3, k <= t.rank and S.C.gold2 or Color3.fromRGB(42, 34, 37), 9)
	end
	S.text(pane, 180, 116, 290, 44, t.desc, S.BODY, 14, Color3.fromRGB(226, 217, 208), { ZIndex = 9, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	for k, e in ipairs(t.effects or {}) do
		S.new("Frame", { Position = UDim2.fromOffset(182, 172 + (k - 1) * 24), Size = UDim2.fromOffset(7, 7), Rotation = 45, BackgroundColor3 = S.C.red2, BorderSizePixel = 0, ZIndex = 9, Parent = pane })
		S.text(pane, 198, 166 + (k - 1) * 24, 270, 20, e, S.BODY, 14, Color3.fromRGB(226, 217, 208), { ZIndex = 9 })
	end
	if t.nextUnlock then
		S.shape(pane, "para", 0, 260, 470, 56, 8, Color3.fromRGB(20, 16, 18), 8)
		S.icon(pane, "lock", 22, 276, 24, S.C.gold, 9)
		S.text(pane, 58, 260, 400, 56, t.nextUnlock, S.BODY, 14, S.C.dim, { ZIndex = 9 })
	end
end

function F:paneItem(pane)
	local S = self.S
	header(S, pane, "Item", "1 por lutador")
	local items = self.D.getHeldItems()
	local cur
	for _, it in ipairs(items) do
		if it.id == self.f.item then
			cur = it
		end
	end
	S.brush(pane, "splash", -30, 30, 280, 240, 0, 7)
	S.shape(pane, "para", 0, 50, 200, 200, 10, cur and S.C.gold or Color3.fromRGB(74, 61, 66), 8)
	local box = S.shape(pane, "para", 2, 52, 196, 196, 9, Color3.fromRGB(20, 15, 17), 8)
	if cur then
		S.icon(box, "item", 48, 48, 100, cur.color, 9)
	else
		local plus = S.new("Frame", { Position = UDim2.fromOffset(66, 50), Size = UDim2.fromOffset(64, 64), BackgroundTransparency = 1, ZIndex = 9, Parent = box }, { S.new("UIStroke", { Color = S.C.gold, Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }) })
		S.text(plus, 0, 0, 64, 64, "+", S.BODY, 40, S.C.gold, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center })
		S.title(box, 0, 124, 196, 24, "VAGO", 16, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = S.C.dim })
	end
	S.title(pane, 224, 50, 246, 34, S.upper(cur and cur.name or "Nenhum item"), 28, { ZIndex = 9, TextColor3 = cur and S.C.bone or S.C.dim, TextWrapped = true })
	S.text(pane, 224, 92, 246, 60, cur and cur.desc or "Itens de segurar dão bônus passivos em batalha.", S.BODY, 14, Color3.fromRGB(226, 217, 208), { ZIndex = 9, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local b = S.catButton(pane, 224, 170, 176, 56, cur and "x" or "i_bag", cur and "Remover" or "Adicionar", nil, 9)
	b.button.Activated:Connect(function()
		if cur then
			self.D.removeItem()
			self:refresh()
			S.sfx("close")
			S.toast(self.root, cur.name .. " voltou para a mochila")
		else
			self:openDrawer()
		end
	end)
end

function F:openDrawer()
	local S = self.S
	if self.drawer then
		return
	end
	local d = S.box(self.main, 0, 464, 470, 430, 20, "Drawer")
	S.rect(d, -30, 0, 530, 470, Color3.fromRGB(8, 6, 7), 20, 0.03)
	S.title(d, 0, 6, 300, 26, "MOCHILA · ITENS DE SEGURAR", 19, { ZIndex = 21 })
	local close = S.catButton(d, 330, 0, 140, 40, "x", "Fechar", nil, 21)
	close.button.Activated:Connect(function()
		self:closeDrawer()
	end)
	for i, it in ipairs(self.D.getHeldItems()) do
		local x, y = ((i - 1) % 3) * 158, 52 + math.floor((i - 1) / 3) * 124
		local b = S.new("TextButton", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(150, 116), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 21, Parent = d })
		local o = S.shape(b, "para", 0, 0, 150, 116, 6, Color3.fromRGB(36, 27, 31), 21)
		S.icon(b, "item", 47, 10, 56, it.color, 22)
		S.title(b, 6, 66, 138, 20, S.upper(it.name), 14, { ZIndex = 22, TextXAlignment = Enum.TextXAlignment.Center })
		S.text(b, 6, 88, 138, 16, "× " .. it.count, S.BODYB, 12, S.C.gold2, { ZIndex = 22, TextXAlignment = Enum.TextXAlignment.Center })
		if it.count <= 0 then
			b.Active = false
			for _, c in ipairs(b:GetDescendants()) do
				if c:IsA("TextLabel") then
					c.TextTransparency = 0.6
				elseif c:IsA("ImageLabel") then
					c.ImageTransparency = 0.6
				end
			end
		end
		b.MouseEnter:Connect(function()
			if it.count > 0 then
				S.recolor(o, Color3.fromRGB(64, 30, 36))
			end
		end)
		b.MouseLeave:Connect(function()
			S.recolor(o, Color3.fromRGB(36, 27, 31))
		end)
		b.Activated:Connect(function()
			if it.count <= 0 then
				return S.sfx("deny")
			end
			self.D.equipItem(it.id)
			self:refresh()
			S.sfx("save")
			S.toast(self.root, it.name .. " equipado")
		end)
	end
	self.drawer = d
	S.tween(d, S.EASE_OUT, { Position = UDim2.fromOffset(0, 30) })
	S.sfx("open")
end

function F:closeDrawer()
	if self.drawer then
		local d = self.drawer
		self.drawer = nil
		self.S.tween(d, self.S.EASE_OUT, { Position = UDim2.fromOffset(0, 480) })
		task.delay(0.25, function()
			d:Destroy()
		end)
		self.S.sfx("close")
	end
end

function F:panePassives(pane)
	local S = self.S
	header(S, pane, "Passivas", "Sempre ativas")
	for i, p in ipairs(self.f.passives) do
		local y = 44 + (i - 1) * 80
		S.shape(pane, "para", 0, y, 470, 72, 8, p.unlocked and Color3.fromRGB(31, 24, 27) or Color3.fromRGB(20, 16, 18), 7)
		local ic = S.new("Frame", { Position = UDim2.fromOffset(18, y + 12), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = S.C.ink, BorderSizePixel = 0, ZIndex = 8, Parent = pane }, { S.new("UIStroke", { Color = p.unlocked and S.C.gold or S.C.line, Thickness = 2 }) })
		S.icon(ic, p.unlocked and "passive" or "lock", 10, 10, 28, p.unlocked and Color3.new(1, 1, 1) or Color3.fromRGB(107, 98, 93), 9)
		S.title(pane, 80, y + 12, 280, 22, S.upper(p.name), 19, { ZIndex = 9, TextColor3 = p.unlocked and S.C.bone or Color3.fromRGB(107, 98, 93) })
		S.text(pane, 80, y + 38, 280, 18, p.desc, S.BODY, 13, S.C.dim, { ZIndex = 9 })
		S.icon(pane, p.unlocked and "check" or "lock", 364, y + 29, 14, p.unlocked and S.C.ok or S.C.gold, 9)
		S.text(pane, 382, y + 26, 84, 20, p.unlocked and "ATIVA" or "BLOQUEADA", S.BODYB, 11, p.unlocked and S.C.ok or S.C.gold, { ZIndex = 9 })
	end
end

function F:action()
	local S = self.S
	S.sfx("select")
	if self.tab == 2 then
		self.hud.go("moves")
	elseif self.tab == 4 then
		self:openDrawer()
	elseif self.tab == 1 then
		S.toast(self.root, (self.f.freePoints or 0) > 0 and "Distribua os pontos" or "Sem pontos livres")
	elseif self.tab == 3 then
		S.toast(self.root, "Melhorar talento")
	end
end

function F:key(k)
	if k == "lb" or k == "up" then
		self:setTab(self.tab - 1)
	elseif k == "rb" or k == "down" then
		self:setTab(self.tab + 1)
	elseif k == "ok" or k == "act" then
		self:action()
	elseif k == "back" and self.drawer then
		self:closeDrawer()
	else
		return false
	end
	return true
end

function F:onShow()
	self:refresh()
end

return F
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">PVEcodex</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Tela ECODEX: busca, filtro por tipo, lista (capturado / visto / ???) e perfil com arte, fatos, descrição e status.
local E = {}
E.__index = E

local STATS = { "HP", "ATQ", "DEF", "ESP", "VEL" }
local FILTERS = { "all", "fogo", "agua", "raio", "sombra", "terra", "vento", "onirico", "normal", "martial" }

function E.new(hud)
	local self = setmetatable({ hud = hud, S = hud.S, D = hud.data, i = 1, q = "", t = "all" }, E)
	self:build()
	return self
end

function E:build()
	local S = self.S
	local root = S.new("CanvasGroup", { Name = "Ecodex", Size = UDim2.fromOffset(1280, 720), BackgroundTransparency = 1, Visible = false, Parent = self.hud.stage })
	self.root = root
	S.rect(root, 0, 0, 1280, 720, Color3.new(0, 0, 0), 0, 0.45)
	S.frame(root, 10, 88, 1262, 556, 1)
	S.slab(root, "Ecodex", "Registro de Ecos da região")
	self.counts = S.box(root, 900, 30, 350, 44, 5)
	local _, l = S.panel(root, 30, 124, 432, 496, { kind = "right", slant = 20, z = 3 })
	-- search
	local sb = S.shape(l, "para", 16, 14, 380, 40, 6, Color3.fromRGB(34, 27, 30), 6)
	S.icon(sb, "search", 14, 11, 18, S.C.dim, 7)
	self.search = S.new("TextBox", {
		Position = UDim2.fromOffset(40, 0), Size = UDim2.fromOffset(330, 40), BackgroundTransparency = 1, Text = "", PlaceholderText = "Buscar por nome ou número",
		PlaceholderColor3 = S.C.mute, TextColor3 = S.C.bone, FontFace = S.BODY, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 7, Parent = sb,
	})
	self.search:GetPropertyChangedSignal("Text"):Connect(function()
		self.q = self.search.Text
		self.i = 1
		self:renderList()
	end)
	self.filterHost = S.box(l, 16, 62, 400, 60, 6)
	self.list = S.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 126), Size = UDim2.fromOffset(400, 358), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5,
		ScrollBarImageColor3 = S.C.red, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 6, Parent = l,
	}, { S.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }), S.new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 2) }) })
	local _, p = S.panel(root, 478, 132, 772, 488, { kind = "left", slant = 20, z = 3 })
	self.prof = S.box(p, 30, 0, 730, 488, 6)
	S.backButton(root, function()
		self.hud.back()
	end)
	self:refresh()
end

function E:refresh()
	local S = self.S
	self.dex = self.D.getDex()
	self.counts:ClearAllChildren()
	for k, c in ipairs({ { self.dex.seen, "VISTOS" }, { self.dex.caught, "CAPTURADOS" }, { self.dex.total, "REGIÃO" } }) do
		local x = (k - 1) * 118
		S.title(self.counts, x, 0, 110, 30, tostring(c[1]), 30, { ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Right })
		S.text(self.counts, x, 30, 110, 12, c[2], S.BODYB, 10, S.C.dim, { ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Right })
	end
	self:renderFilters()
	self:renderList()
end

function E:renderFilters()
	local S = self.S
	self.filterHost:ClearAllChildren()
	local x, y = 0, 0
	for _, t in ipairs(FILTERS) do
		local label = t == "all" and "Todos" or S.TYPES[t][1]
		local w = 22 + (utf8.len(label) or #label) * 7
		if x + w > 400 then
			x, y = 0, y + 28
		end
		local on = self.t == t
		local b = S.new("TextButton", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 7, Parent = self.filterHost })
		S.shape(b, "para", 0, 0, w, 24, 5, on and (t == "all" and S.C.bone or S.TYPES[t][2]) or Color3.fromRGB(36, 29, 32), 7)
		S.text(b, 0, 0, w, 24, S.upper(label), S.BODYB, 11, on and (t == "all" and S.C.ink or Color3.new(1, 1, 1)) or S.C.dim, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center })
		b.Activated:Connect(function()
			self.t = t
			self.i = 1
			S.sfx("tick")
			self:renderFilters()
			self:renderList()
		end)
		x += w + 5
	end
end

function E:filtered()
	local q = string.lower(self.q)
	local out = {}
	for _, e in ipairs(self.dex.entries) do
		local okT = self.t == "all" or (e.status ~= "unknown" and table.find(e.types, self.t))
		local okQ = q == "" or string.find(e.no, q, 1, true) or (e.status ~= "unknown" and string.find(string.lower(e.name), q, 1, true))
		if okT and okQ then
			table.insert(out, e)
		end
	end
	return out
end

function E:renderList()
	local S = self.S
	for _, c in ipairs(self.list:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local L = self:filtered()
	self.i = math.clamp(self.i, 1, math.max(1, #L))
	for k, e in ipairs(L) do
		local focus = k == self.i
		local b = S.new("TextButton", { LayoutOrder = k, Size = UDim2.fromOffset(384, 44), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 7, Parent = self.list })
		S.shape(b, "para", 0, 0, 384, 44, 7, focus and S.C.bone or Color3.fromRGB(28, 21, 24), 7)
		S.shape(b, "para", 2, 2, 380, 40, 6, focus and Color3.fromRGB(42, 29, 34) or Color3.fromRGB(28, 21, 24), 7)
		S.text(b, 14, 0, 50, 44, "Nº" .. e.no, S.BODYB, 12, S.C.mute, { ZIndex = 8 })
		local unk = e.status == "unknown"
		if not unk then
			local dot = S.new("Frame", { Position = UDim2.fromOffset(70, 11), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = e.status == "caught" and (S.TYPES[e.types[1]] or S.TYPES.normal)[2] or Color3.fromRGB(8, 6, 7), ZIndex = 8, Parent = b }, { S.new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
			if e.image then
				S.new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = e.image, ImageColor3 = e.status == "caught" and Color3.new(1, 1, 1) or Color3.new(0, 0, 0), ZIndex = 9, Parent = dot })
			end
		end
		S.title(b, 102, 0, 180, 44, unk and "???" or S.upper(e.name), 18, { ZIndex = 8, TextColor3 = unk and Color3.fromRGB(107, 98, 93) or S.C.bone })
		if not unk then
			S.icon(b, e.status == "caught" and "i_capture" or "eye", 284, 14, 16, e.status == "caught" and Color3.new(1, 1, 1) or S.C.dim, 8)
			S.text(b, 304, 0, 76, 44, e.status == "caught" and "CAPTURADO" or "VISTO", S.BODYB, 10, S.C.dim, { ZIndex = 8 })
		end
		b.Activated:Connect(function()
			self.i = k
			S.sfx("select")
			self:renderList()
		end)
	end
	if #L == 0 then
		S.text(self.list, 0, 0, 380, 60, "Nenhum Eco encontrado. Tente outro nome ou limpe o filtro.", S.BODY, 13, S.C.dim, { TextWrapped = true, ZIndex = 8 })
	end
	self:renderProfile(L[self.i])
end

function E:renderProfile(e)
	local S = self.S
	self.prof:ClearAllChildren()
	if not e then
		return
	end
	local caught, unk = e.status == "caught", e.status == "unknown"
	local tc = unk and S.TYPES.normal[2] or (S.TYPES[e.types[1]] or S.TYPES.normal)[2]
	-- art on a brush splash tinted by the type
	local art = S.box(self.prof, 0, 20, 300, 300, 7)
	S.brush(art, "splash", -30, -10, 360, 320, 0, 7)
	S.new("ImageLabel", { Position = UDim2.fromOffset(-30, -10), Size = UDim2.fromOffset(360, 320), BackgroundTransparency = 1, Image = S.Config.Images.brush_splash, ImageColor3 = tc, ImageTransparency = 0.45, ZIndex = 8, Parent = art })
	if e.image and not unk then
		S.new("ImageLabel", { Position = UDim2.fromOffset(30, 30), Size = UDim2.fromOffset(240, 240), BackgroundTransparency = 1, Image = e.image, ImageColor3 = caught and Color3.new(1, 1, 1) or Color3.new(0, 0, 0), ScaleType = Enum.ScaleType.Fit, ZIndex = 9, Parent = art })
	else
		S.title(art, 0, 0, 300, 300, unk and "?" or "", 120, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(90, 79, 83) })
	end
	S.title(art, 0, -6, 120, 30, "Nº" .. e.no, 24, { ZIndex = 10, TextColor3 = S.C.gold2 })
	local x = 320
	S.title(self.prof, x, 20, 400, 50, unk and "???" or S.upper(e.name), 44, { ZIndex = 9 })
	S.text(self.prof, x, 72, 400, 16, unk and "Ainda não visto" or ((e.kind or "") .. (e.status == "seen" and " · visto, não capturado" or "")), S.BODY, 14, S.C.dim, { ZIndex = 9 })
	local cx = x
	if unk then
		S.chip(self.prof, cx, 96, "normal", "???", 9)
	else
		for _, t in ipairs(e.types) do
			local _, w = S.chip(self.prof, cx, 96, t, nil, 9)
			cx += w + 6
		end
	end
	local facts = { { "ALTURA", caught and e.height and (string.gsub(string.format("%.1f m", e.height), "%.", ",")) or "—" }, { "PESO", caught and e.weight and (string.gsub(tostring(e.weight) .. " kg", "%.", ",")) or "—" }, { "STATUS", caught and "Capturado" or e.status == "seen" and "Visto" or "—" } }
	for k, f in ipairs(facts) do
		local g = S.shape(self.prof, "para", x + (k - 1) * 134, 130, 126, 48, 5, Color3.fromRGB(29, 22, 25), 9)
		S.text(g, 12, 6, 110, 12, f[1], S.BODYB, 10, S.C.mute, { ZIndex = 10 })
		S.text(g, 12, 22, 110, 20, f[2], S.BODYB, 16, S.C.bone, { ZIndex = 10 })
	end
	local desc = caught and (e.desc or "") or e.status == "seen" and "Capture este Eco para ler o registro completo." or "Encontre este Eco para registrar."
	S.text(self.prof, x, 190, 400, 80, desc, S.BODY, 15, Color3.fromRGB(226, 217, 208), { ZIndex = 9, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	for k, name in ipairs(STATS) do
		local col, row = (k - 1) % 2, math.floor((k - 1) / 2)
		local sx, sy = col * 360, 340 + row * 26
		local v = caught and e.stats and e.stats[k] or nil
		S.text(self.prof, sx, sy, 40, 16, name, S.BODYB, 12, S.C.dim, { ZIndex = 9 })
		S.text(self.prof, sx + 40, sy, 30, 16, v and tostring(v) or "??", S.BODYB, 12, S.C.bone, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Right })
		S.rect(self.prof, sx + 80, sy + 5, 250, 7, Color3.fromRGB(42, 34, 37), 9)
		if v then
			local f = S.rect(self.prof, sx + 80, sy + 5, 0, 7, tc, 10)
			S.tween(f, S.SLOW, { Size = UDim2.fromOffset(250 * math.min(1, v / 120), 7) })
		end
	end
	S.text(self.prof, 0, 440, 700, 20, "Habitat  " .. (unk and "???" or (e.habitat or "—")), S.BODY, 13, S.C.dim, { ZIndex = 9 })
end

function E:key(k)
	local L = self:filtered()
	if k == "down" then
		self.i = math.min(#L, self.i + 1)
	elseif k == "up" then
		self.i = math.max(1, self.i - 1)
	elseif k == "search" then
		self.search:CaptureFocus()
		return true
	else
		return false
	end
	self.S.sfx("tick")
	self:renderList()
	return true
end

function E:onShow()
	self:refresh()
end

return E
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">PVPerfil</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Tela PERFIL DO TREINADOR: cartão (avatar, nome, título, dinheiro, números), insígnias, equipe e opções.
local Players = game:GetService("Players")

local P = {}
P.__index = P

function P.new(hud)
	local self = setmetatable({ hud = hud, S = hud.S, D = hud.data }, P)
	self:build()
	return self
end

function P:build()
	local S = self.S
	local root = S.new("CanvasGroup", { Name = "Perfil", Size = UDim2.fromOffset(1280, 720), BackgroundTransparency = 1, Visible = false, Parent = self.hud.stage })
	self.root = root
	S.rect(root, 0, 0, 1280, 720, Color3.new(0, 0, 0), 0, 0.45)
	S.frame(root, 10, 88, 1262, 556, 1)
	S.slab(root, "Perfil", "Cartão de treinador")
	local _, card = S.panel(root, 30, 124, 612, 290, { kind = "right", slant = 26, z = 3 })
	self.card = S.box(card, 0, 0, 612, 290, 6)
	local _, badges = S.panel(root, 30, 424, 612, 196, { kind = "right", slant = 20, z = 3 })
	self.badges = S.box(badges, 0, 0, 612, 196, 6)
	local _, team = S.panel(root, 656, 132, 594, 282, { kind = "left", slant = 20, z = 3 })
	self.team = S.box(team, 0, 0, 594, 282, 6)
	local _, opt = S.panel(root, 656, 424, 594, 196, { kind = "left", slant = 20, z = 3 })
	S.title(opt, 36, 12, 200, 26, "OPÇÕES", 22, { ZIndex = 7 })
	for i, o in ipairs({ { "title", "i_profile", "Editar título" }, { "avatar", "i_fighters", "Trocar avatar" }, { "settings", "i_settings", "Configurações" }, { "account", "i_account", "Conta e dados" } }) do
		local c = S.catButton(opt, 34 + ((i - 1) % 2) * 270, 52 + math.floor((i - 1) / 2) * 70, 258, 62, o[2], o[3], nil, 7)
		c.button.Activated:Connect(function()
			S.sfx("select")
			if o[1] == "settings" then
				self.hud.openApp("settings")
			else
				self.D.profileOption(o[1])
			end
		end)
	end
	S.backButton(root, function()
		self.hud.back()
	end)
	self:refresh()
end

local function badgeShape(S, parent, x, y, color, earned)
	local g = S.box(parent, x, y, 58, 58, 8)
	S.shape(g, "para", 0, 4, 58, 50, 8, earned and S.C.gold or S.C.line, 8)
	S.shape(g, "para", 3, 7, 52, 44, 7, earned and color or Color3.fromRGB(20, 16, 18), 8)
	S.icon(g, earned and "star" or "lock", 17, 17, 24, earned and Color3.new(1, 1, 1) or Color3.fromRGB(90, 79, 83), 9)
	return g
end

function P:refresh()
	local S = self.S
	local p = self.D.getProfile()
	-- card
	self.card:ClearAllChildren()
	local av = S.box(self.card, 24, 18, 190, 250, 7)
	S.brush(av, "splash", -60, -20, 300, 290, 0, 7)
	local img = S.new("ImageLabel", { Position = UDim2.fromOffset(5, 20), Size = UDim2.fromOffset(180, 230), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop, ZIndex = 8, Parent = av })
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(p.userId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420)
		end)
		if ok then
			img.Image = url
		end
	end)
	local x = 236
	S.title(self.card, x, 20, 340, 46, S.upper(p.name), 42, { ZIndex = 8 })
	local tw = 24 + (utf8.len(p.title) or #p.title) * 8
	S.shape(self.card, "para", x, 70, tw, 24, 5, S.C.red, 8)
	S.title(self.card, x + 10, 70, tw, 24, S.upper(p.title), 14, { ZIndex = 9 })
	S.new("Frame", { Position = UDim2.fromOffset(x, 106), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = S.C.gold2, ZIndex = 8, Parent = self.card }, { S.new("UICorner", { CornerRadius = UDim.new(1, 0) }), S.new("UIStroke", { Color = Color3.fromRGB(138, 100, 16), Thickness = 2 }) })
	local money = tostring(p.money):reverse():gsub("(%d%d%d)", "%1."):reverse():gsub("^%.", "")
	S.title(self.card, x + 40, 104, 250, 34, money, 32, { ZIndex = 8, TextColor3 = S.C.gold2 })
	local facts = { { "ID", p.id }, { "TEMPO", p.playtime }, { "VITÓRIAS", tostring(p.wins) }, { "CAPTURADOS", p.caught }, { "VISTOS", tostring(p.seen) }, { "DESDE", p.since } }
	for k, f in ipairs(facts) do
		local fx, fy = x + ((k - 1) % 3) * 114, 150 + math.floor((k - 1) / 3) * 56
		local g = S.shape(self.card, "para", fx, fy, 108, 48, 5, Color3.fromRGB(29, 22, 25), 8)
		S.text(g, 10, 6, 96, 12, f[1], S.BODYB, 10, S.C.mute, { ZIndex = 9 })
		S.text(g, 10, 22, 96, 20, f[2], S.BODYB, 15, S.C.bone, { ZIndex = 9 })
	end
	-- badges
	self.badges:ClearAllChildren()
	local earned = 0
	for _, b in ipairs(p.badges) do
		if b.earned then
			earned += 1
		end
	end
	S.title(self.badges, 20, 12, 200, 26, "INSÍGNIAS", 22, { ZIndex = 8 })
	S.text(self.badges, 450, 16, 120, 16, earned .. " / " .. #p.badges, S.BODYB, 12, S.C.dim, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
	for k, b in ipairs(p.badges) do
		local bx = 20 + (k - 1) * 70
		badgeShape(S, self.badges, bx, 56, b.color, b.earned)
		S.text(self.badges, bx - 6, 120, 70, 14, b.earned and S.upper(b.name) or "???", S.BODYB, 10, b.earned and S.C.dim or S.C.mute, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center })
	end
	-- team
	self.team:ClearAllChildren()
	local n = 0
	for _, m in ipairs(p.team) do
		if m then
			n += 1
		end
	end
	S.title(self.team, 36, 12, 300, 26, "FIGHTERS NA EQUIPE", 22, { ZIndex = 8 })
	S.text(self.team, 440, 16, 120, 16, n .. " / 6", S.BODYB, 12, S.C.dim, { ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Right })
	for k, m in ipairs(p.team) do
		local tx, ty = 36 + ((k - 1) % 3) * 180, 52 + math.floor((k - 1) / 3) * 110
		S.shape(self.team, "para", tx, ty, 172, 100, 8, m and Color3.fromRGB(36, 27, 31) or Color3.fromRGB(20, 16, 18), 8)
		if m then
			local tc = (S.TYPES[m.typeKey] or S.TYPES.normal)[2]
			local dot = S.new("Frame", { Position = UDim2.fromOffset(tx + 14, ty + 24), Size = UDim2.fromOffset(50, 50), BackgroundColor3 = tc, ZIndex = 9, Parent = self.team }, { S.new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
			if m.image then
				S.new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = m.image, ZIndex = 10, Parent = dot })
			end
			S.title(self.team, tx + 72, ty + 30, 96, 20, S.upper(m.name), 15, { ZIndex = 9 })
			S.text(self.team, tx + 72, ty + 52, 96, 14, "Lv " .. m.level .. " · " .. (S.TYPES[m.typeKey] or S.TYPES.normal)[1], S.BODYB, 11, S.C.dim, { ZIndex = 9 })
		else
			S.text(self.team, tx, ty, 172, 100, "VAGO", S.BODYB, 12, S.C.mute, { ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center })
		end
	end
end

function P:key()
	return false
end

function P:onShow()
	self:refresh()
end

return P
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">PVPhone</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HUD lateral + CELULAR: aba na borda esquerda (tecla M) que sobe o celular com os apps.
-- Abrir um app: o ícone cresce até a tela do celular, passa o corte vermelho e a tela do app entra.
local Ph = {}
Ph.__index = Ph

function Ph.new(hud)
	local self = setmetatable({ hud = hud, S = hud.S, open = false, focus = 1 }, Ph)
	self:build()
	return self
end

function Ph:build()
	local S = self.S
	local root = S.box(self.hud.stage, 0, 0, 1280, 720, 50, "Phone")
	self.root = root
	-- side tab
	local tab = S.new("TextButton", { Name = "PhoneTab", Position = UDim2.fromOffset(0, 190), Size = UDim2.fromOffset(86, 78), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 51, Parent = root })
	S.shape(tab, "right", 0, 0, 86, 78, 10, S.C.gold, 51)
	S.shape(tab, "right", 0, 2, 84, 74, 9, S.C.deep, 51)
	S.brush(tab, "streak", 10, 44, 90, 22, -8, 52, 0.2)
	S.icon(tab, "i_phone", 24, 10, 36, Color3.new(1, 1, 1), 53)
	S.title(tab, 0, 50, 80, 20, "CELULAR", 13, { ZIndex = 53, TextXAlignment = Enum.TextXAlignment.Center })
	S.text(tab, 62, 4, 18, 12, "M", S.BODYB, 10, S.C.gold, { ZIndex = 53 })
	self.tabBase = tab.Position
	tab.MouseEnter:Connect(function()
		S.tween(tab, S.SNAP, { Size = UDim2.fromOffset(100, 78) })
		S.sfx("tick")
	end)
	tab.MouseLeave:Connect(function()
		S.tween(tab, S.SNAP, { Size = UDim2.fromOffset(86, 78) })
	end)
	tab.Activated:Connect(function()
		self:toggle()
	end)
	self.tab = tab
	-- phone body (rotates with its children; no clipping inside rotated frames, so rounded corners come from UICorner)
	local ph = S.new("Frame", { Name = "Body", AnchorPoint = Vector2.new(0.2, 1), Position = UDim2.fromOffset(110 + 66, 720 + 700), Size = UDim2.fromOffset(330, 640), Rotation = -9, BackgroundColor3 = Color3.fromRGB(26, 20, 23), ZIndex = 54, Parent = root }, {
		S.new("UICorner", { CornerRadius = UDim.new(0, 38) }), S.new("UIStroke", { Color = Color3.fromRGB(70, 58, 62), Thickness = 2 }),
	})
	self.body = ph
	local scr = S.new("Frame", { Name = "Screen", Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(306, 616), BackgroundColor3 = Color3.fromRGB(18, 11, 14), ZIndex = 55, Parent = ph }, { S.new("UICorner", { CornerRadius = UDim.new(0, 28) }) })
	self.screen = scr
	S.new("ImageLabel", { Size = UDim2.fromOffset(306, 440), BackgroundTransparency = 1, Image = S.Config.Images.wallpaper, ScaleType = Enum.ScaleType.Crop, ZIndex = 55, Parent = scr }, { S.new("UICorner", { CornerRadius = UDim.new(0, 28) }) })
	local shade = S.rect(scr, 0, 0, 306, 616, Color3.fromRGB(8, 6, 7), 56, 0)
	S.new("UICorner", { CornerRadius = UDim.new(0, 28), Parent = shade })
	S.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(0.3, 1), NumberSequenceKeypoint.new(0.46, 1), NumberSequenceKeypoint.new(0.6, 0.15), NumberSequenceKeypoint.new(1, 0.05) }), Parent = shade })
	S.new("Frame", { Position = UDim2.fromOffset(108, 8), Size = UDim2.fromOffset(90, 22), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 58, Parent = scr }, { S.new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	self.clock = S.title(scr, 24, 40, 260, 60, "00:00", 58, { ZIndex = 58 })
	self.place = S.text(scr, 26, 102, 260, 14, S.upper(S.Config.PhonePlace or "Ilha Verdejante"), S.BODYB, 12, S.C.gold, { ZIndex = 58 })
	-- app grid
	self.apps = {}
	for i, a in ipairs(S.Config.PhoneApps) do
		local x, y = 22 + ((i - 1) % 3) * 94, 300 + math.floor((i - 1) / 3) * 104
		local b = S.new("TextButton", { Name = a.id, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(78, 96), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 58, Parent = scr })
		local ic = S.box(b, 3, 0, 72, 72, 58)
		local out = S.shape(ic, "para", 0, 0, 72, 72, 8, S.C.gold, 58)
		S.shape(ic, "para", 2, 2, 68, 68, 7, Color3.fromRGB(28, 21, 24), 58)
		S.icon(ic, a.icon, 16, 16, 40, Color3.new(1, 1, 1), 59)
		if a.badge then
			S.rect(ic, 54, -4, 20, 20, S.C.red, 60)
		end
		S.title(b, 0, 76, 78, 18, S.upper(a.name), 13, { ZIndex = 59, TextXAlignment = Enum.TextXAlignment.Center })
		local sc = S.new("UIScale", { Scale = 0.6, Parent = b })
		b.MouseEnter:Connect(function()
			S.tween(ic, S.SNAP, { Position = UDim2.fromOffset(3, -3), Rotation = -3 })
			S.sfx("tick")
		end)
		b.MouseLeave:Connect(function()
			S.tween(ic, S.SNAP, { Position = UDim2.fromOffset(3, 0), Rotation = 0 })
		end)
		b.Activated:Connect(function()
			self:openApp(i)
		end)
		self.apps[i] = { button = b, scale = sc, outline = out, def = a, icon = ic }
	end
	-- mission widget
	local wid = S.shape(scr, "para", 18, 526, 270, 74, 8, Color3.fromRGB(0, 0, 0), 57, 0.45)
	S.text(wid, 16, 10, 240, 12, "MISSÃO ATIVA", S.BODYB, 10, S.C.gold, { ZIndex = 58 })
	self.mission = S.text(wid, 16, 26, 240, 36, "Nenhuma missão ativa", S.BODYB, 14, S.C.bone, { ZIndex = 58, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	-- red wipe used for the hand-over to the full screen
	self.wipe = S.new("Frame", { Name = "Wipe", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(1900, 360), Size = UDim2.fromOffset(420, 1400), Rotation = 14, BackgroundColor3 = S.C.red, BorderSizePixel = 0, ZIndex = 90, Visible = false, Parent = self.hud.stage })
	task.spawn(function()
		while root.Parent do
			local t = os.date("*t")
			self.clock.Text = string.format("%02d:%02d", t.hour, t.min)
			task.wait(5)
		end
	end)
end

function Ph:setMission(text)
	self.mission.Text = (text and text ~= "") and text or "Nenhuma missão ativa"
end

function Ph:toggle()
	if self.open then
		self:close()
	else
		self:show()
	end
end

function Ph:show()
	local S = self.S
	if self.open then
		return
	end
	self.open = true
	S.tween(self.body, S.SLOW, { Position = UDim2.fromOffset(110 + 66, 708), Rotation = -2.5 })
	for i, a in ipairs(self.apps) do
		a.scale.Scale = 0.6
		task.delay(0.12 + i * 0.03, function()
			S.tween(a.scale, S.POP, { Scale = 1 })
		end)
	end
	self.focus = 1
	self:decorate()
	S.sfx("open")
end

function Ph:close(silent)
	local S = self.S
	if not self.open then
		return
	end
	self.open = false
	S.tween(self.body, S.EASE_OUT, { Position = UDim2.fromOffset(110 + 66, 720 + 700), Rotation = -9 })
	if not silent then
		S.sfx("close")
	end
end

function Ph:decorate()
	for i, a in ipairs(self.apps) do
		self.S.recolor(a.outline, i == self.focus and self.S.C.bone or self.S.C.gold)
	end
end

function Ph:openApp(i)
	local S = self.S
	local a = self.apps[i]
	if not a then
		return
	end
	S.sfx("select")
	local id = a.def.id
	local function handOver()
		self.wipe.Visible = true
		self.wipe.Position = UDim2.fromOffset(1700, 360)
		S.tween(self.wipe, TweenInfo.new(0.52, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(-420, 360) })
		task.delay(0.2, function()
			self:close(true)
			self.hud.openApp(id)
		end)
		task.delay(0.55, function()
			self.wipe.Visible = false
		end)
	end
	if S.Config.ReducedMotion then
		self:close(true)
		self.hud.openApp(id)
		return
	end
	-- icon grows to fill the phone screen
	local z = S.new("Frame", { Position = a.icon.Position + a.button.Position, Size = UDim2.fromOffset(72, 72), BackgroundColor3 = Color3.fromRGB(28, 21, 24), ZIndex = 70, Parent = self.screen }, { S.new("UICorner", { CornerRadius = UDim.new(0, 4) }) })
	S.icon(z, a.def.icon, 16, 16, 40, Color3.new(1, 1, 1), 71)
	S.tween(z, TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(306, 616) })
	task.delay(0.32, function()
		handOver()
		task.delay(0.3, function()
			z:Destroy()
		end)
	end)
end

function Ph:key(k)
	if not self.open then
		return false
	end
	local n = #self.apps
	if k == "right" then
		self.focus = self.focus % n + 1
	elseif k == "left" then
		self.focus = (self.focus - 2) % n + 1
	elseif k == "down" then
		self.focus = math.min(n, self.focus + 3)
	elseif k == "up" then
		self.focus = math.max(1, self.focus - 3)
	elseif k == "ok" then
		self:openApp(self.focus)
		return true
	elseif k == "back" then
		self:close()
		return true
	else
		return false
	end
	self.S.sfx("tick")
	self:decorate()
	return true
end

return Ph
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">PVHud</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PVHud: creates the HUD (ScreenGui 1280x720 scaled to any screen), the phone and every screen, routes
-- navigation (Voltar / Backspace / B) and input (mouse, touch, keyboard, gamepad).
--
-- From your own LocalScripts:
--   local Hud = require(ReplicatedStorage.PVHudKit.PVHud)
--   Hud.open("ficha")            -- "moves", "ficha", "ecodex", "perfil"
--   Hud.close()
--   Hud.learnMove("oni")         -- level-up banner with "Equipar agora" / "Depois"
--   Hud.setMission("Encontrar o Nico no Círculo de Pedra")
--   Hud.AppOpened.Event:Connect(function(appId) ... end)   -- apps you already have (bag, settings, map)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local root = script.Parent
local S = require(root:WaitForChild("PVStyle"))
local Data = require(root:WaitForChild("PVData"))

local Hud = {}
Hud.AppOpened = Instance.new("BindableEvent")
local started = false

function Hud.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local pg = player:WaitForChild("PlayerGui")
	local gui = S.new("ScreenGui", { Name = "PVHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = S.Config.DisplayOrder, ZIndexBehavior = Enum.ZIndexBehavior.Global, Parent = pg })
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
	end)
	local stage = S.new("Frame", { Name = "Stage", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1280, 720), BackgroundTransparency = 1, Parent = gui })
	local fit = S.new("UIScale", { Parent = stage })
	local function refit()
		local a = gui.AbsoluteSize
		if a.X > 0 then
			fit.Scale = math.min(a.X / 1280, a.Y / 720)
		end
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	refit()
	-- drag layer: same coordinate space as InputObject.Position (below the top bar)
	local dragGui = S.new("ScreenGui", { Name = "PVHudDrag", ResetOnSpawn = false, IgnoreGuiInset = false, DisplayOrder = S.Config.DisplayOrder + 1, Parent = pg })

	local ctx = { S = S, data = Data, stage = stage, dragGui = dragGui, playerGui = pg }
	function ctx.scale()
		return fit.Scale
	end
	local screens, stack, current = {}, {}, nil

	local function showScreen(name, push)
		local sc = screens[name]
		if not sc then
			return
		end
		if current == name then
			return
		end
		if current then
			local old = screens[current]
			if push then
				table.insert(stack, current)
			end
			S.tween(old.root, S.SNAP, { GroupTransparency = 1 })
			task.delay(0.15, function()
				if current ~= old.screenId then
					old.root.Visible = false
				end
			end)
		end
		current = name
		sc.screenId = name
		if sc.onShow then
			sc:onShow()
		end
		sc.root.Visible = true
		sc.root.GroupTransparency = 1
		sc.root.Position = UDim2.fromOffset(24, 0)
		S.tween(sc.root, S.EASE_OUT, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
		ctx.phone.tab.Visible = false
	end
	local function closeAll()
		if current then
			local old = screens[current]
			S.tween(old.root, S.SNAP, { GroupTransparency = 1 })
			task.delay(0.15, function()
				old.root.Visible = false
			end)
		end
		current = nil
		table.clear(stack)
		ctx.phone.tab.Visible = true
	end
	function ctx.go(name)
		showScreen(name, true)
	end
	function ctx.back()
		local prev = table.remove(stack)
		if prev then
			showScreen(prev, false)
		else
			closeAll()
			ctx.phone:show()
		end
	end
	local APP_SCREEN = { ficha = "ficha", ecodex = "ecodex", perfil = "perfil", moves = "moves" }
	function ctx.openApp(id)
		if APP_SCREEN[id] then
			table.clear(stack)
			showScreen(APP_SCREEN[id], false)
		else
			Hud.AppOpened:Fire(id)
		end
	end

	ctx.phone = require(root.PVPhone).new(ctx)
	screens.moves = require(root.PVMoves).new(ctx)
	screens.ficha = require(root.PVFicha).new(ctx)
	screens.ecodex = require(root.PVEcodex).new(ctx)
	screens.perfil = require(root.PVPerfil).new(ctx)

	function Hud.open(name)
		table.clear(stack)
		ctx.phone:close(true)
		showScreen(name, false)
	end
	Hud.close = closeAll
	function Hud.learnMove(id)
		Hud.open("moves")
		screens.moves:learn(id)
	end
	function Hud.setMission(text)
		ctx.phone:setMission(text)
	end
	function Hud.isOpen()
		return current ~= nil or ctx.phone.open
	end
	Data.Changed.Event:Connect(function()
		if current and screens[current].refresh then
			screens[current]:refresh()
		end
	end)

	-- ------------------------------------------------------------------ input
	local KEYS = {
		[Enum.KeyCode.Up] = "up", [Enum.KeyCode.Down] = "down", [Enum.KeyCode.Left] = "left", [Enum.KeyCode.Right] = "right",
		[Enum.KeyCode.DPadUp] = "up", [Enum.KeyCode.DPadDown] = "down", [Enum.KeyCode.DPadLeft] = "left", [Enum.KeyCode.DPadRight] = "right",
		[Enum.KeyCode.Return] = "ok", [Enum.KeyCode.ButtonA] = "ok", [Enum.KeyCode.Backspace] = "back", [Enum.KeyCode.ButtonB] = "back",
		[Enum.KeyCode.Q] = "lb", [Enum.KeyCode.E] = "rb", [Enum.KeyCode.ButtonL1] = "lb", [Enum.KeyCode.ButtonR1] = "rb",
		[Enum.KeyCode.One] = "1", [Enum.KeyCode.Two] = "2", [Enum.KeyCode.Three] = "3", [Enum.KeyCode.Four] = "4",
		[Enum.KeyCode.Slash] = "search", [Enum.KeyCode.ButtonX] = "act",
	}
	UserInputService.InputBegan:Connect(function(input, processed)
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == S.Config.PhoneKey or input.KeyCode == S.Config.PhoneGamepadKey then
			if current then
				closeAll()
			end
			ctx.phone:toggle()
			return
		end
		local k = KEYS[input.KeyCode]
		if not k then
			return
		end
		-- Esc is reserved by Roblox; Backspace / B do "Voltar"
		if current then
			local sc = screens[current]
			if (GuiService.SelectedObject == nil or k ~= "ok") and sc:key(k) then
				return
			end
			if k == "back" then
				S.sfx("close")
				ctx.back()
			end
		elseif ctx.phone.open then
			if not processed or k == "back" then
				ctx.phone:key(k)
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		local t = input.UserInputType
		if (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) and current == "moves" then
			screens.moves:inputChanged(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) and current == "moves" then
			screens.moves:inputEnded(input)
		end
	end)
	Hud.ctx = ctx
	Hud.screens = screens
end

return Hud
]]></ProtectedString></Properties></Item></Item></roblox>